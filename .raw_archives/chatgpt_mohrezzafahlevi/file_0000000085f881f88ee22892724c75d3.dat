  "model_counts": {
    "total": 36,
    "base_models": 23,
    "addon_models": 13,
    "domains": 15,
    "domain_plugins": 15,
    "addons": 9
  },
  "orm_contract": {
    "implementation": "custom thin MW-native ORM",
    "third_party_orm_dependency": false,
    "public_field_types": [
      "String",
      "Text",
      "Integer",
      "Decimal",
      "Boolean",
      "DateTime",
      "Enum",
      "Reference",
      "Relation"
    ],
    "required": [
      "model_registry",
      "domain_registry",
      "domain_database_router",
      "create",
      "create_many",
      "get_by_ref",
      "find",
      "find_one",
      "count",
      "update",
      "delete",
      "single_domain_transactions",
      "parameterized_query_compiler",
      "ordering",
      "pagination",
      "validation"
    ],
    "forbidden": [
      "Drizzle",
      "Prisma",
      "TypeORM",
      "Sequelize",
      "ORM-on-ORM layering",
      "Odoo API compatibility requirement",
      "cross-domain JOIN",
      "cross-domain FK"
    ]
  },
  "future_plugin_evolution": {
    "v1": "trusted native ESM components, startup composition, local built-ins",
    "v2_candidate": "signed/distributed native component packages with provenance verification",
    "v3_candidate": "WASM Component plugins with WIT-defined imports/exports and runtime-enforced capabilities",
    "must_preserve_now": [
      "versioned manifests",
      "versioned extension points",
      "explicit imports/exports semantics",
      "opaque payload/contracts across future foreign boundary",
      "no leakage of raw runtime/database objects into plugin contracts"
    ],
    "do_not_implement_now": [
      "Extism runtime",
      "Wasmtime runtime",
      "WASI plugin loader",
      "remote plugin marketplace",
      "hot code unload",
      "dynamic third-party installation while process is serving requests"
    ]
  },
  "supply_chain_policy": {
    "v1": [
      "do not auto-run every discovered package",
      "profile is explicit activation allowlist",
      "plugins.lock.json pins version and manifest hash",
      "built-in source paths are explicit"
    ],
    "future_marketplace": [
      "artifact signature verification",
      "source/build provenance verification",
      "TUF-style trusted target metadata is a candidate",
      "SLSA provenance is a candidate"
    ]
  },
  "non_overlap_rules": [
    "do not move Cockpit TaskCache or tasks_projection into mw-edge",
    "do not persist Radicle issues/patches as mw-edge canonical records",
    "do not replace mw-identity or mw-security",
    "do not turn mw-storage into relational persistence",
    "do not merge apps/webhook into mw-edge",
    "do not register mw-edge as permanent production daemon until a dedicated service-boundary ADR is accepted",
    "do not create generic Cockpit browser proxy /api/data/:model"
  ],
  "file_layout": {
    "root": "apps/mw-edge",
    "required": [
      "src/kernel/plugins/host.js",
      "src/kernel/plugins/registry.js",
      "src/kernel/plugins/manifest.js",
      "src/kernel/plugins/resolver.js",
      "src/kernel/plugins/lifecycle.js",
      "src/kernel/plugins/extensions.js",
      "src/kernel/plugins/capabilities.js",
      "src/kernel/orm/",
      "src/kernel/database/",
      "src/kernel/migrations/",
      "plugins/<domain>/plugin.json",
      "plugins/<domain>/index.js",
      "plugins/<domain>/models/",
      "plugins/<domain>/migrations/",
      "addons/<addon>/plugin.json",
      "addons/<addon>/index.js",
      "addons/<addon>/models/",
      "addons/<addon>/migrations/",
      "profiles/kernel-only.json",
      "profiles/business-base.json",
      "profiles/business-standard.json",
      "profiles/erp.json",
      "profiles/isp.json",
      "profiles/full.json",
      "plugins.lock.json",
      "data/",
      "test/",
      "README.md"
    ]
  },
  "implementation_order": [
    "T00 audit live repository, AGENTS.md, governance and current branch",
    "T01 scaffold mw-edge kernel with zero business models",
    "T02 implement strict plugin/addon manifest JSON schema and validators",
    "T03 implement profile resolver and deterministic plugins.lock.json",
    "T04 implement dependency graph resolver with cycle/conflict/version checks",
    "T05 implement staged plugin registry, lifecycle and atomic registry publication",
    "T06 implement extension-point registry and version checks",
    "T07 implement capability-shaped host context for trusted native ESM components",
    "T08 implement native ORM and model/domain registry",
    "T09 implement one-domain-one-database router and SQLite adapter",
    "T10 implement per-domain/component migration engine and incomplete-startup journal",
    "T11 implement all 15 domain plugins and all base models",
    "T12 implement all 9 addons and all addon models",
    "T13 implement all profiles and full-profile resolution",
    "T14 implement domain services/commands without hidden cross-domain magic",
    "T15 implement optional internal Hono adapter without making it a permanent platform service",
    "T16 implement plugin lifecycle, migration, profile and ORM tests",
    "T17 implement full-profile boot test that creates/migrates/validates all 36 models across 15 databases",
    "T18 lint, format, security/adversarial tests and autofix",
    "T19 add focused GitLab CI without destabilizing unrelated jobs",
    "T20 document plugin authoring, addon authoring, profiles, DB ownership and future WASM seam",
    "T21 run full release gate, commit logical batches, produce exact final report"
  ],
  "test_contract": {
    "mandatory": [
