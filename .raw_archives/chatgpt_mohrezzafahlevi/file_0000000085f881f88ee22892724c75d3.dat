    ]
  },
  "research_basis": [
    {
      "source": "Backstage backend plugin/module architecture",
      "url": "https://backstage.io/docs/backend-system/architecture/",
      "adopt": [
        "plugin and module are distinct concepts",
        "module extends one target plugin through explicit extension points",
        "logical database isolation per plugin/domain",
        "extension points are versionable smaller surfaces rather than one giant plugin API"
      ],
      "adaptation_for_mw": "MW runs built-in domain plugins in one modular application process in v1; cross-domain direct code imports remain forbidden even when colocated."
    },
    {
      "source": "OSGi architecture",
      "url": "https://www.osgi.org/resources/architecture/",
      "adopt": [
        "explicit module lifecycle",
        "explicit imports/exports",
        "service/contract registry mindset",
        "modularity means minimizing assumptions and shared internals"
      ]
    },
    {
      "source": "PF4J plugin lifecycle and extension points",
      "url": "https://pf4j.org/doc/plugin-lifecycle.html",
      "adopt": [
        "distinguish discovered/resolved/started/disabled states",
        "only active components contribute extensions"
      ]
    },
    {
      "source": "MoonWitness mw-whatsapp native plugin architecture",
      "repository_path": "crates/mw-whatsapp/agent_docs/plugin_architecture.md",
      "adopt": [
        "manifest validation before publication",
        "topological dependency resolution",
        "staged installation",
        "transactional registry publication",
        "reverse-order cleanup",
        "capability-shaped host APIs",
        "future foreign-language adapter seam"
      ],
      "note": "Conceptual alignment only; do not couple mw-edge implementation to mw-whatsapp runtime code."
    },
    {
      "source": "WASI 0.3 / WebAssembly Component Model",
      "url": "https://bytecodealliance.org/articles/WASI-0.3",
      "adopt_for_future": [
        "WIT-shaped versioned contracts",
        "imports/exports as future plugin boundary",
        "async composability path for future sandboxed plugins"
      ],
      "v1_rule": "Do not implement WASM plugin runtime in v1."
    },
    {
      "source": "WebAssembly Component Model WIT",
      "url": "https://component-model.bytecodealliance.org/design/wit.html",
      "adopt_for_future": [
        "contract-first interfaces",
        "host requirements and plugin exports remain explicit"
      ]
    },
    {
      "source": "SQLite ATTACH semantics",
      "url": "https://sqlite.org/lang_attach.html",
      "adopt": [
        "do not claim multi-domain transaction atomicity",
        "domain transactions remain scoped to one logical database"
      ]
    },
    {
      "source": "SLSA provenance",
      "url": "https://slsa.dev/spec/v1.2/provenance",
      "adopt_for_future": [
        "plugin package build/source provenance can be verified when distribution/marketplace exists"
      ]
    },
    {
      "source": "The Update Framework",
      "url": "https://theupdateframework.io/docs/metadata/",
      "adopt_for_future": [
        "signed target metadata and delegated trust are candidate mechanisms for a future plugin marketplace"
      ]
    }
  ],
  "mission": {
    "primary": "Implement apps/mw-edge as a MoonWitness-native modular business data engine with a custom thin ORM, microkernel plugin host, one logical database per bounded domain, explicit addons, deterministic profiles, and all existing 36 business models implemented.",
    "must_not_become": [
      "Odoo clone",
      "universal MoonWitness database",
      "Cockpit replacement",
      "generic browser-facing ORM gateway",
      "identity or authorization system",
      "task/Git/Radicle persistence replacement",
      "third-party ORM wrapper"
    ]
  },
  "hard_architecture_decisions": {
    "orm": "MW-native custom thin ORM",
    "drizzle": "forbidden",
    "prisma": "forbidden",
    "typeorm": "forbidden",
    "sequelize": "forbidden",
    "database_v1": "SQLite",
    "database_future": "Cloudflare D1 adapter",
    "database_topology": "one bounded domain = one logical database",
    "kernel_business_models": 0,
    "domain_plugin_owns_database": true,
    "addon_owns_database": false,
    "addon_extends_exactly_one_domain_plugin": true,
    "profile_owns_models": false,
    "cross_domain_sql_fk": false,
    "cross_domain_sql_join": false,
    "cross_domain_atomic_transaction_claim": false,
    "hot_install_v1": false,
    "hot_unload_v1": false,
    "profile_change_requires_restart_v1": true,
    "native_plugins_trusted_v1": true,
    "native_capabilities_are_security_sandbox_v1": false,
    "future_untrusted_plugin_runtime": "WASM Component Model/WIT candidate; not part of v1"
  },
  "kernel": {
    "rule": "Kernel owns mechanisms only; it owns no business domain model and no business database.",
    "components": [
      "plugin_host",
      "manifest_validator",
      "dependency_resolver",
      "profile_resolver",
      "plugin_lock_manager",
      "lifecycle_manager",
      "extension_registry",
      "capability_broker",
      "model_registry",
      "domain_registry",
      "domain_database_registry",
      "database_router",
      "native_orm",
      "query_compiler",
      "migration_engine",
      "installation_journal",
      "internal_http_adapter"
    ],
    "forbidden": [
      "business.organization in kernel",
      "crm.contact in kernel",
      "catalog.product in kernel",
      "any other business model in kernel",
      "kernel.db as a business data store"
    ]
  },
  "component_model": {
    "kinds": {
      "domain_plugin": {
        "definition": "Owns one bounded business domain, its base models, extension points, and exactly one logical database.",
        "database": "required_exactly_one",
        "may_define_base_models": true,
        "may_expose_extension_points": true
      },
      "addon": {
        "definition": "Optional module that extends exactly one domain plugin through explicit extension points.",
        "database": "must_share_target_domain_database",
        "may_define_models": true,
        "may_alter_base_tables": false,
        "may_create_own_tables": true,
        "may_fk_to_guaranteed_same_domain_tables": true
      },
      "profile": {
        "definition": "Declarative composition of plugins/addons and configuration.",
        "may_define_models": false,
        "may_define_migrations": false,
        "may_contain_business_logic": false
      }
    },
    "composition_over_inheritance": true,
    "no_monkey_patch": true,
    "no_prototype_mutation": true,
    "no_direct_plugin_internal_imports": true
  },
  "plugin_system": {
    "v1_loading_model": "startup composition only",
    "discovery": {
      "built_in_roots": [
        "./plugins",
        "./addons"
      ],
      "scan_node_modules_automatically": false,
      "run_discovered_package_automatically": false,
      "rule": "presence on disk means discoverable, not enabled or active"
    },
    "states": [
      "absent",
      "discovered",
      "validated",
      "resolved",
      "planned",
      "staged",
      "migrated",
      "active",
      "disabled",
      "failed"
    ],
    "activation_source": "selected profile plus resolved plugin lock",
    "lockfile": {
      "path": "apps/mw-edge/plugins.lock.json",
      "required_fields": [
        "profile_id",
        "profile_hash",
        "component_id",
        "kind",
        "version",
        "domain",
        "source",
        "manifest_sha256",
        "resolved_dependencies"
      ],
      "purpose": "deterministic reproducible plugin set; do not use directory scan order as authority"
    },
    "manifest_contract": {
      "format": "strict JSON",
      "json_schema": "Draft 2020-12",
      "required_common_fields": [
        "schema_version",
        "id",
        "kind",
        "version",
        "host_api",
        "domain",
        "entrypoint",
        "models",
        "migrations",
        "capabilities"
      ],
      "domain_plugin_required": [
        "database",
        "extension_points"
      ],
      "addon_required": [
        "extends",
        "uses_extension_points"
      ],
      "semver_required": true,
      "unknown_required_capability": "fail_closed",
      "duplicate_component_id": "fail_closed",
      "dependency_cycle": "fail_closed",
      "incompatible_host_api": "fail_closed"
    },
    "startup_sequence": [
      "discover configured component roots",
      "parse and schema-validate manifests",
      "resolve selected profile",
      "verify plugin lock or intentionally regenerate in explicit development workflow",
      "validate IDs, versions, domains, capabilities and extension-point versions",
      "resolve component dependencies topologically",
      "stage domain plugin model descriptors and extension points without publishing them",
      "initialize addons so they can register contributions into their target plugin extension points",
      "freeze extension registration",
      "plan per-domain migrations in deterministic component order",
      "apply migrations one domain database at a time",
      "validate final composite model/domain registry",
      "activate plugin services and addon contributions",
      "atomically publish the active registry"
    ],
    "failure_semantics": {
      "registry_publication": "all_or_nothing",
      "migration_across_domains": "not_atomic",
      "on_component_init_failure": "do_not_publish_active_registry; cleanup staged runtime resources in reverse dependency order",
      "on_migration_failure": "stop startup; preserve already committed per-domain migrations; record incomplete startup journal; next boot must reconcile idempotently",
      "never_claim_global_rollback": true
    },
    "disable_uninstall_policy": {
      "disable_v1": "remove from profile and restart; code/data remain present",
      "uninstall_v1": "remove from profile and package source then restart",
      "data_default": "retain",
      "destructive_purge": "separate explicit command requiring dependency and ownership checks",
      "automatic_down_migration": false,
      "downgrade": "unsupported by default unless explicit tested forward-compatible path exists"
    }
  },
  "extension_points": {
    "rules": [
      "extension point IDs are stable and versioned",
      "addon may extend exactly one domain plugin",
      "addon may use multiple extension points from its one target plugin",
      "registration occurs during staging/startup only in v1",
      "extension registration is frozen before plugin activation",
      "addons must not access plugin private implementation modules",
      "base plugin never requires optional addon code to load"
    ],
    "allowed_contribution_types_v1": [
      "model_descriptor",
      "validator",
      "domain_command",
      "query_handler",
      "projector",
      "internal_http_route",
      "observer"
    ]
  },
  "capability_model": {
    "v1_statement": "Native ESM plugins/addons are trusted in-process code. Capabilities shape supported APIs and ownership but are not a sandbox.",
    "kernel_handles": [
      "scoped_orm_for_own_domain",
      "model_registration",
      "extension_registration",
      "domain_command_registration",
      "validator_registration",
      "query_registration",
      "internal_route_registration",
      "structured_logger",
      "configuration_read"
    ],
    "forbidden_handles": [
      "raw access to another domain database",
      "raw SQLite connection for another domain",
      "Cockpit internals",
      "mw-identity internals",
      "mw-security internals",
      "Git/Radicle internals"
    ],
    "future": {
      "untrusted_boundary": "WASM Component Model/WIT",
      "enforcement": "capabilities must become runtime-enforced at foreign/sandbox boundary"
    }
  },
  "database_topology": {
    "rule": "one active domain plugin owns exactly one logical database; all addons extending that domain share it",
    "sqlite_files": {
      "billing": "apps/mw-edge/data/billing.db",
      "business": "apps/mw-edge/data/business.db",
      "catalog": "apps/mw-edge/data/catalog.db",
      "commerce": "apps/mw-edge/data/commerce.db",
      "crm": "apps/mw-edge/data/crm.db",
      "entitlement": "apps/mw-edge/data/entitlement.db",
      "finance": "apps/mw-edge/data/finance.db",
      "inventory": "apps/mw-edge/data/inventory.db",
      "isp": "apps/mw-edge/data/isp.db",
      "knowledge": "apps/mw-edge/data/knowledge.db",
      "procurement": "apps/mw-edge/data/procurement.db",
      "provisioning": "apps/mw-edge/data/provisioning.db",
      "reseller": "apps/mw-edge/data/reseller.db",
      "service": "apps/mw-edge/data/service.db",
      "support": "apps/mw-edge/data/support.db"
    },
    "model_routing": "model_name -> model_registry -> domain -> domain_database_registry -> adapter",
    "developer_manual_db_selection_for_model_operations": false,
    "same_domain_relation": "Relation allowed when target component is guaranteed by plugin/addon dependency graph",
    "cross_domain_link": "Reference only",
    "optional_addon_target_from_base_model": "Reference only; base plugin must not require optional addon table",
    "transaction_scope": "single domain database",
    "cross_domain_workflow": "explicit orchestration using stable references; no distributed atomicity claim",
    "sqlite_attach_for_cross_domain_business_transactions": "forbidden in v1"
  },
  "migration_system": {
    "tracking_table_per_domain": "mw_migrations",
    "tracking_columns": [
      "component_id",
      "component_version",
      "migration_id",
      "checksum",
      "applied_at"
    ],
    "ordering": [
      "target domain plugin core migrations first",
      "addon migrations in resolved topological order",
      "migration filenames ordered deterministically within component"
    ],
    "rules": [
      "every migration is namespaced by component_id",
      "historical checksum mismatch fails closed",
      "migration rerun is idempotent",
      "migration transaction is scoped to one domain database",
      "addon may create/drop only addon-owned schema during explicit purge",
      "addon normal migration must not add/drop/rename/reinterpret base plugin columns",
      "base plugin migration must not alter addon-owned tables"
    ]
  },
