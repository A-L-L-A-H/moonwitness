  "profiles": [
    {
      "id": "kernel-only",
      "description": "MW Edge kernel without business domain plugins.",
      "components": [],
      "intended_use": "kernel and plugin-host tests"
    },
    {
      "id": "business-base",
      "description": "Small commercial service lifecycle foundation.",
      "components": [
        "mw.catalog",
        "mw.commerce",
        "mw.service",
        "mw.entitlement",
        "mw.provisioning"
      ],
      "intended_use": "default development profile"
    },
    {
      "id": "business-standard",
      "description": "Business, CRM, reseller, billing, support and knowledge suite.",
      "components": [
        "mw.business",
        "mw.business.project",
        "mw.crm",
        "mw.crm.pipeline",
        "mw.reseller",
        "mw.reseller.commission",
        "mw.catalog",
        "mw.commerce",
        "mw.service",
        "mw.billing",
        "mw.billing.payment",
        "mw.entitlement",
        "mw.provisioning",
        "mw.support",
        "mw.support.escalation",
        "mw.knowledge"
      ],
      "intended_use": "general business installation"
    },
    {
      "id": "erp",
      "description": "Business standard plus procurement, inventory and finance.",
      "extends": "business-standard",
      "components": [
        "mw.procurement",
        "mw.inventory",
        "mw.finance"
      ],
      "intended_use": "ERP-oriented installation"
    },
    {
      "id": "isp",
      "description": "Business standard plus ISP subscriber/network/RADIUS/PPPoE/accounting capabilities.",
      "extends": "business-standard",
      "components": [
        "mw.isp",
        "mw.isp.network",
        "mw.isp.radius",
        "mw.isp.pppoe",
        "mw.isp.accounting"
      ],
      "intended_use": "ISP installation"
    },
    {
      "id": "full",
      "description": "All built-in domain plugins and addons; mandatory CI conformance profile.",
      "components": [
        "mw.billing",
        "mw.business",
        "mw.catalog",
        "mw.commerce",
        "mw.crm",
        "mw.entitlement",
        "mw.finance",
        "mw.inventory",
        "mw.isp",
        "mw.knowledge",
        "mw.procurement",
        "mw.provisioning",
        "mw.reseller",
        "mw.service",
        "mw.support",
        "mw.business.project",
        "mw.crm.pipeline",
        "mw.reseller.commission",
        "mw.billing.payment",
        "mw.support.escalation",
        "mw.isp.network",
        "mw.isp.radius",
        "mw.isp.pppoe",
        "mw.isp.accounting"
      ],
      "intended_use": "CI, migration compatibility and complete model verification"
    }
  ],
  "default_profile": "business-base",
  "ci_required_profile": "full",
  "model_catalog": [
    {
      "name": "business.organization",
      "table": "business_organizations",
      "domain": "business",
      "authority": "CANONICAL",
      "contract_status": "provisional",
      "must_create": true,
      "purpose": "Commercial organization record without replacing identity, membership, tenant authorization, or trust.",
      "fields": {
        "organization_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "ref_kind": "tenant_scope"
        },
        "name": {
          "type": "String",
          "required": true
        },
        "organization_type": {
          "type": "Enum",
          "required": true,
          "enum": [
            "internal",
            "customer",
            "vendor",
            "reseller",
            "other"
          ]
        },
        "lifecycle": {
          "type": "Enum",
          "required": true,
          "enum": [
            "draft",
            "active",
            "suspended",
            "archived"
          ],
          "default": "draft"
        },
        "owner_ref": {
          "type": "Reference",
          "ref_kind": "identity_or_organization_owner"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "organization is not identity",
        "organization is not membership",
        "organization lifecycle is not authorization"
      ],
      "database": {
        "domain": "business",
        "logical_database": "business.db",
        "sqlite_path": "apps/mw-edge/data/business.db"
      },
      "component": {
        "kind": "domain_plugin",
        "id": "mw.business",
