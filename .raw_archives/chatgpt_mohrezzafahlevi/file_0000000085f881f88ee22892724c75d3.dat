    "ask_user_for_ordinary_engineering_decisions": false
  },
  "repository": {
    "provider": "gitlab",
    "project": "bjo163/mw",
    "default_branch": "master",
    "source_of_truth": "live_repository_state",
    "must_read_first": [
      "AGENTS.md",
      "README.md",
      "package.json",
      "pnpm-workspace.yaml",
      "Cargo.toml",
      ".gitlab-ci.yml",
      "config/services.json",
