      "domain": "billing",
      "entrypoint": "./plugins/billing/index.js",
      "manifest": "./plugins/billing/plugin.json",
      "database": {
        "ownership": "exclusive_domain_owner",
        "logical_name": "billing",
        "sqlite_path": "./data/billing.db",
