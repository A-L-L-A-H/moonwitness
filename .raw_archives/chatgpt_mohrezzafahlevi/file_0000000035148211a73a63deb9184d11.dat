  "research_basis": [
    {
      "source": "Backstage backend plugin/module architecture",
      "url": "https://backstage.io/docs/backend-system/architecture/",
      "adopt": [
        "plugin and module are distinct concepts",
        "module extends one target plugin through explicit extension points",
        "logical database isolation per plugin/domain",
        "extension points are versionable smaller surfaces rather than one giant plugin API"
      ],
      "adaptation_for_mw": "MW runs built-in domain plugins in one modular application process in v1; cross-domain direct code imports remain forbidden even when colocated."
    },
    {
      "source": "OSGi architecture",
      "url": "https://www.osgi.org/resources/architecture/",
      "adopt": [
        "explicit module lifecycle",
        "explicit imports/exports",
        "service/contract registry mindset",
        "modularity means minimizing assumptions and shared internals"
      ]
    },
    {
      "source": "PF4J plugin lifecycle and extension points",
      "url": "https://pf4j.org/doc/plugin-lifecycle.html",
      "adopt": [
        "distinguish discovered/resolved/started/disabled states",
        "only active components contribute extensions"
      ]
    },
    {
      "source": "MoonWitness mw-whatsapp native plugin architecture",
      "repository_path": "crates/mw-whatsapp/agent_docs/plugin_architecture.md",
      "adopt": [
        "manifest validation before publication",
        "topological dependency resolution",
        "staged installation",
        "transactional registry publication",
        "reverse-order cleanup",
        "capability-shaped host APIs",
        "future foreign-language adapter seam"
      ],
      "note": "Conceptual alignment only; do not couple mw-edge implementation to mw-whatsapp runtime code."
    },
    {
      "source": "WASI 0.3 / WebAssembly Component Model",
      "url": "https://bytecodealliance.org/articles/WASI-0.3",
      "adopt_for_future": [
        "WIT-shaped versioned contracts",
        "imports/exports as future plugin boundary",
        "async composability path for future sandboxed plugins"
      ],
      "v1_rule": "Do not implement WASM plugin runtime in v1."
    },
    {
      "source": "WebAssembly Component Model WIT",
      "url": "https://component-model.bytecodealliance.org/design/wit.html",
      "adopt_for_future": [
        "contract-first interfaces",
        "host requirements and plugin exports remain explicit"
      ]
    },
    {
      "source": "SQLite ATTACH semantics",
      "url": "https://sqlite.org/lang_attach.html",
      "adopt": [
        "do not claim multi-domain transaction atomicity",
        "domain transactions remain scoped to one logical database"
      ]
    },
    {
      "source": "SLSA provenance",
      "url": "https://slsa.dev/spec/v1.2/provenance",
      "adopt_for_future": [
        "plugin package build/source provenance can be verified when distribution/marketplace exists"
      ]
    },
    {
      "source": "The Update Framework",
      "url": "https://theupdateframework.io/docs/metadata/",
      "adopt_for_future": [
        "signed target metadata and delegated trust are candidate mechanisms for a future plugin marketplace"
      ]
    },
    {
      "source": "JSON Forms UI Schema",
      "url": "https://jsonforms.io/docs/uischema/",
      "adopt": [
        "separate data/model schema from presentation schema",
        "metadata-defined controls, layouts, and conditional rules",
        "renderer registry instead of arbitrary executable code in metadata"
      ],
      "adaptation_for_mw": "Use an MW-native UI metadata schema rendered with @mw/ui; do not add JSON Forms as a runtime dependency unless later justified."
    },
    {
      "source": "Vite production build and backend integration",
      "url": "https://vite.dev/guide/build",
      "adopt": [
        "Vite standalone development server",
        "static production bundle",
        "same-origin backend integration",
        "relative/embedded base path compatibility"
      ],
      "adaptation_for_mw": "Reuse the repository's existing Vite/React/@mw/ui stack and keep browser requests relative to /api."
    },
    {
      "source": "Vite dev server proxy",
      "url": "https://vite.dev/config/server-options",
      "adopt": [
        "development /api proxy to the local MW Edge HTTP adapter",
        "explicit allowed hosts rather than broad wildcard trust"
      ]
    },
    {
      "source": "Backstage frontend extensions",
      "url": "https://backstage.io/docs/frontend-system/architecture/plugins/",
      "adopt": [
        "frontend capabilities contributed by installed plugins",
        "explicit extension IDs and extension configuration",
        "plugin-provided navigation/pages without hardcoding all routes in one app"
      ],
      "adaptation_for_mw": "Most MW Edge screens are metadata-generated; trusted plugins may additionally contribute explicit custom UI extensions through versioned slots."
    },
    {
      "source": "Unicode CLDR stable release data",
