  "metadata_driven_ui": {
    "enabled": true,
    "principle": "Data/model metadata defines default navigation, list, search, form and command surfaces. UI metadata references model fields but does not duplicate field type truth.",
    "schema_standard": "JSON Schema Draft 2020-12",
    "renderer": {
      "runtime": "React",
      "build_tool": "Vite",
      "component_library": "@mw/ui",
      "asset_library": "@mw/assets",
      "custom_form_framework": "MW metadata renderer",
      "json_forms_runtime_dependency": false,
      "metadata_may_contain_javascript": false,
      "metadata_eval_forbidden": true,
      "renderer_keys_allowlisted": true
    },
    "metadata_sources": [
      "model descriptors in active domain plugins/addons",
      "plugin ui.json descriptors",
      "addon ui contributions through explicit UI extension points"
    ],
    "canonical_split": {
      "model_descriptor": "field type, required/default/read-only/reference/relation semantics and domain ownership",
      "ui_descriptor": "labels, navigation, list columns, search fields, form layout, widgets, visibility and command placement"
    },
    "required_resource_metadata": [
      "resource_id",
      "metadata_version",
      "label",
      "navigation",
      "crud",
      "views"
    ],
    "view_types_v1": [
      "list",
      "detail",
      "form",
      "search"
    ],
    "layout_nodes_v1": [
      "section",
      "row",
      "column",
      "tabs",
      "field"
    ],
    "ui_extension_slots": [
      "app.navigation",
      "app.dashboard",
      "resource.list.column",
      "resource.list.filter",
      "resource.detail.panel",
      "resource.form.section",
      "resource.action"
    ],
    "addon_rules": [
      "addon UI contributions target its one domain plugin only",
      "addon cannot arbitrary-patch another plugin's metadata JSON",
      "every contribution has stable ID, versioned slot, deterministic order and owning component ID",
      "duplicate contribution ID fails closed",
      "unknown target resource/field/slot fails closed",
      "metadata never grants backend authorization"
    ],
    "generated_fallback": {
      "allowed": true,
      "rule": "If a model has no explicit ui.json, generate a deterministic safe CRUD presentation from model metadata; production base models should still ship explicit descriptors where useful."
    },
    "metadata_api": [
      "GET /api/meta/app",
      "GET /api/meta/plugins",
      "GET /api/meta/resources",
      "GET /api/meta/resources/:model",
      "GET /api/meta/navigation"
    ],
    "standalone_admin_data_api": {
      "enabled_only_when": "mw.standalone active and caller is authenticated local superuser",
      "routes": [
        "GET /api/admin/resources/:model",
        "GET /api/admin/resources/:model/:ref",
        "POST /api/admin/resources/:model",
        "PATCH /api/admin/resources/:model/:ref",
        "DELETE /api/admin/resources/:model/:ref"
      ],
      "rules": [
        "only models explicitly exposing standalone admin CRUD may be used",
        "sensitive fields are never returned",
        "foundation reference models are read-only through generic UI",
        "standalone.session is not generic CRUD visible",
        "this API is not the Cockpit browser API and must not be proxied generically through Cockpit"
      ]
    },
    "domain_commands": {
      "rule": "business lifecycle actions use explicit domain commands, not arbitrary model method names from UI metadata",
      "metadata_may_reference_registered_command_ids": true
    }
  },
