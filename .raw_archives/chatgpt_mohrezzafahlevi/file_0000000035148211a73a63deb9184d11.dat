          "is_superuser": false,
          "login_enabled": false,
          "must_rotate_password": false,
          "password": null
        }
      ],
      "admin_password_bootstrap": {
        "priority": [
          "MW_BOOTSTRAP_ADMIN_PASSWORD environment variable supplied explicitly",
          "secure random one-time password generated on first standalone bootstrap"
        ],
        "universal_default_password": false,
        "raw_password_database_storage": false,
        "password_hash": "Node.js built-in crypto.scrypt with random salt and versioned parameters",
        "generated_password_minimum_entropy": "at least 192 random bits before encoding",
        "generated_credential_file": "apps/mw-edge/data/.bootstrap/admin-credentials.json",
        "credential_file_permissions": "0600 where supported; fail or prominently warn if secure permissions cannot be established in production standalone mode",
        "console_behavior": "show once only on interactive first bootstrap; never print password in CI logs",
        "rotation": "successful mandatory rotation deletes generated credential file when it exists"
      },
      "bot_rules": [
        "mw.bot is a non-login system actor",
        "mw.bot has no password",
        "mw.bot must not be claimed as a human identity",
        "mw.bot may be referenced as actor for deterministic bootstrap/system operations where appropriate"
      ]
    }
  },
  "factory_reset": {
    "required": true,
    "http_endpoint": false,
    "cli_only_v1": true,
    "commands": {
      "all_active_profile": "pnpm --filter @mw/mw-edge factory:reset -- --profile <profile> --yes",
      "single_domain": "pnpm --filter @mw/mw-edge db:reset -- --domain <domain> --yes",
      "reseed_only": "pnpm --filter @mw/mw-edge seed:reapply -- --profile <profile>"
    },
    "safety": [
      "refuse if target path is outside apps/mw-edge/data",
      "acquire exclusive reset lock",
      "refuse while MW Edge standalone server holds the database unless coordinated shutdown is proven",
      "interactive confirmation unless --yes",
      "non-interactive destructive reset additionally requires MW_ALLOW_FACTORY_RESET=1",
      "never touch Cockpit SQLite projections, tasks/, Git/Radicle state, mw-storage data, or other repository databases"
    ],
    "default_backup": {
      "enabled": true,
      "path": "apps/mw-edge/data/backups/<timestamp>/",
      "disable_flag": "--no-backup"
    },
    "algorithm": [
      "resolve and validate selected profile",
      "resolve active plugins/addons deterministically",
      "record reset plan",
      "close domain connections",
      "backup affected domain DB files unless explicitly disabled",
      "remove affected .db, -wal and -shm files",
      "recreate each domain database",
      "run component migrations deterministically",
      "apply required/reference seeds deterministically",
      "bootstrap standalone principals if mw.standalone is active",
      "regenerate one-time super-admin credential unless explicitly preserving local access is a supported and selected mode",
      "run integrity, seed-count and model-registry verification",
      "write reset report containing hashes/counts but no secrets"
    ],
    "postcondition": "Fresh-install and factory-reset observable baseline must be equivalent for the same profile, source commit, plugin lock, configuration and seed versions."
  },
  "standalone_local_access": {
    "enabled_by_component": "mw.standalone",
    "purpose": "Make MW Edge independently usable without claiming to replace platform identity/security.",
    "canonical_platform_identity": false,
    "password_storage": "scrypt hash only",
    "session_storage": "hash session tokens; never raw token",
    "browser_session": {
