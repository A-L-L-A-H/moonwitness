    {
      "name": "business.organization",
      "table": "business_organizations",
      "domain": "business",
      "authority": "CANONICAL",
      "contract_status": "provisional",
      "must_create": true,
      "purpose": "Commercial organization record without replacing identity, membership, tenant authorization, or trust.",
      "fields": {
        "organization_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "ref_kind": "tenant_scope"
        },
        "name": {
          "type": "String",
          "required": true
        },
        "organization_type": {
          "type": "Enum",
          "required": true,
          "enum": [
            "internal",
            "customer",
            "vendor",
            "reseller",
            "other"
          ]
        },
        "lifecycle": {
          "type": "Enum",
          "required": true,
          "enum": [
            "draft",
            "active",
            "suspended",
            "archived"
          ],
          "default": "draft"
        },
        "owner_ref": {
          "type": "Reference",
          "ref_kind": "identity_or_organization_owner"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "organization is not identity",
        "organization is not membership",
        "organization lifecycle is not authorization"
