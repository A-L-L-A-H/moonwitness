      "baseline_requirements": [
        "complete pinned country/territory list selected by the generator policy, not a hand-written subset",
        "active currency reference set from the pinned source",
        "at minimum Indonesian and English language records; generator may include a wider pinned set",
        "complete IANA timezone identifier snapshot for the pinned tzdb release",
        "id-ID locale preset",
        "en-US locale preset",
        "default standalone locale is configurable and defaults to id-ID",
        "default standalone country is configurable and defaults to ID",
        "default standalone currency is configurable and defaults to IDR",
