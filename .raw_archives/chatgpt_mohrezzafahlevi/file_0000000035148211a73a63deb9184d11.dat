    },
    "rules": [
      "seed application is deterministic and idempotent",
      "required/reference seed checksum mismatch fails closed",
      "changing an already-applied immutable seed requires a new seed version or seed ID",
      "reset works entirely from vendored data; network is never required",
      "plugin seeds may write only to models owned by that plugin",
      "addon seeds may write only to addon-owned models unless an explicit target-plugin seed extension point allows otherwise",
