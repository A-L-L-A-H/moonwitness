<!doctype html>
<html lang="id">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#060a10"><title>MOONWITNESS — Universe Command Center</title>
<style>
:root{--bg:#060b12;--panel:#0c141e;--panel2:#101b27;--line:#213040;--line2:#304357;--text:#eaf1f8;--soft:#adbecd;--muted:#70869a;--blue:#75caff;--pale:#bce5ff;--amber:#efc68b;--red:#ff838b;--green:#87d8b7;--purple:#c3a2ff;--radius:12px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;min-height:100vh;overflow-x:hidden}body:before{content:"";position:fixed;inset:0;background-image:linear-gradient(to right,rgba(93,127,163,.035) 1px,transparent 1px),linear-gradient(to bottom,rgba(93,127,163,.028) 1px,transparent 1px);background-size:64px 64px;pointer-events:none;z-index:0}button,input,select,textarea{font:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--blue);outline-offset:3px}a{color:inherit;text-decoration:none}p{line-height:1.65}.mono,.eyebrow,.tag,.smallcaps{font-family:ui-monospace,SFMono-Regular,Consolas,"Liberation Mono",monospace}.eyebrow{font-size:11px;letter-spacing:.17em;text-transform:uppercase;color:var(--blue)}.muted{color:var(--muted)}.soft{color:var(--soft)}.topbar{height:73px;border-bottom:1px solid var(--line);background:#080d14ed;backdrop-filter:blur(16px);display:flex;align-items:center;justify-content:space-between;padding:0 max(4.2vw,25px);position:sticky;top:0;z-index:20}.brand{display:flex;align-items:center;gap:13px;min-width:220px}.mark{border:1px solid #315475;background:#0a1b2a;border-radius:50%;height:37px;width:37px;display:grid;place-items:center;position:relative;overflow:hidden}.mark:before{content:"";width:21px;height:21px;border-radius:50%;box-shadow:-7px 0 0 0 #99d6ff;transform:translate(5px,0)}.brand-name{font-weight:850;font-size:14px;letter-spacing:.13em}.brand small{display:block;margin-top:3px;letter-spacing:.14em;font-size:9px;color:#6e899e}.top-center{display:flex;gap:35px;align-items:center}.top-link{font-size:11px;text-transform:uppercase;letter-spacing:.14em;color:#93a9bb;background:none;border:0;padding:25px 0}.top-link:hover{color:var(--blue)}.switcher{display:flex;align-items:center;gap:4px;padding:4px;border:1px solid #2b4155;border-radius:8px;background:#101923}.switch{padding:9px 13px;color:#91a7b9;border:0;background:transparent;border-radius:5px;font-size:11px;font-weight:780;letter-spacing:.1em}.switch.active{background:#204562;color:#e4f5ff}.small-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#81d0ff;margin-right:7px;box-shadow:0 0 12px #6ebfff}.portal{max-width:1470px;margin:0 auto;padding:0 4.2vw 80px}.hero{min-height:570px;display:grid;grid-template-columns:1fr 1fr;position:relative;border-bottom:1px solid var(--line);align-items:center}.hero-left{position:relative;z-index:2;padding:68px 0 65px}.hero-meta{display:flex;gap:28px;font-size:10px;color:#85a5be;letter-spacing:.15em;margin-bottom:26px;text-transform:uppercase}.hero h1{font-size:clamp(58px,7.8vw,114px);line-height:.89;margin:0;letter-spacing:-.075em;font-weight:870;max-width:830px}.hero h1 span{color:#83cfff}.hero-desc{font-size:clamp(15px,1.3vw,19px);color:#a7bbca;max-width:460px;margin:27px 0 27px}.hero-kicker{font-size:11px;letter-spacing:.24em;margin-top:20px;color:#f1c68e;text-transform:uppercase}.hero-actions{display:flex;gap:13px;flex-wrap:wrap;margin-top:28px}.btn{background:#83cfff;color:#07121b;font-weight:790;font-size:11px;letter-spacing:.1em;text-transform:uppercase;border:1px solid #8bceff;padding:14px 19px;border-radius:6px;transition:transform .2s,background .2s}.btn:hover{transform:translateY(-2px);background:#a9ddff}.btn-secondary{background:transparent;color:#c3d5e4;border-color:#405469}.btn-secondary:hover{background:#122536}.btn-tiny{padding:9px 11px;font-size:10px}.hero-art{height:490px;position:relative;display:grid;place-items:center;overflow:hidden}.orbital{width:min(100%,560px);height:auto;overflow:visible;filter:drop-shadow(0 0 18px rgba(84,181,255,.12))}.orbit-slow{transform-origin:center;animation:spin 90s linear infinite}.orbit-reverse{transform-origin:center;animation:spin 64s linear infinite reverse}.orbit-pulse{animation:pulse 4s ease-in-out infinite}.hero-art:after{content:"SIGNAL SOURCE  /  UNKNOWN";position:absolute;bottom:37px;right:10px;font:10px ui-monospace,monospace;color:#64849f;letter-spacing:.13em}.number-ruler{display:flex;gap:20px;justify-content:space-between;border-bottom:1px solid var(--line);padding:18px 0;margin-bottom:70px;flex-wrap:wrap}.ruler-item{display:flex;align-items:baseline;gap:9px}.ruler-item strong{font-size:19px}.ruler-item span{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#7890a3}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:0 0 26px}.section-head h2{font-size:clamp(26px,3vw,42px);margin:9px 0 0;letter-spacing:-.05em}.section-head p{color:#90a6b8;max-width:455px;margin:0;font-size:13px}.section{margin-top:70px}.story-layout{display:grid;grid-template-columns:1.28fr .87fr .87fr;gap:14px}.story{border:1px solid var(--line);background:linear-gradient(140deg,#101a25,#0b121b);min-height:278px;padding:23px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden;transition:border-color .2s,transform .2s;cursor:pointer;text-align:left;width:100%;color:inherit}.story:hover,.collection:hover{border-color:#497ea7;transform:translateY(-3px)}.story:before{content:"";position:absolute;inset:-35px -30px auto auto;width:160px;height:160px;border:1px solid #2e4961;border-radius:50%;box-shadow:0 0 0 35px rgba(47,83,110,.1),0 0 0 70px rgba(47,83,110,.06);pointer-events:none}.story.primary{background:linear-gradient(125deg,#15293c,#08111a)}.story .id{display:flex;justify-content:space-between;color:#80a9c8;font-size:10px;letter-spacing:.1em}.story h3{font-size:clamp(22px,2.2vw,35px);line-height:1.07;letter-spacing:-.045em;margin:22px 0 10px;position:relative}.story p{font-size:12px;color:#9db3c4;margin:0;max-width:300px;line-height:1.55;position:relative}.story-foot{display:flex;justify-content:space-between;color:#b3cfe2;align-items:center;font-size:10px;margin-top:20px}.tag{font-size:9px;letter-spacing:.1em;border:1px solid #2d4a62;background:#122335;color:#9bc9e8;display:inline-block;border-radius:3px;padding:6px 8px;white-space:nowrap}.tag.amber{border-color:#584937;background:#251e17;color:#f0c991}.tag.red{border-color:#614149;background:#2a1720;color:#ffabb2}.tag.green{border-color:#2b5c4d;background:#122b28;color:#a0e9cd}.tag.purple{border-color:#50406d;background:#221932;color:#c9aff8}.filterbar{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:20px}.filterbar button{border:1px solid #2a4053;background:transparent;color:#92abc0;padding:9px 11px;border-radius:5px;font-size:10px;letter-spacing:.08em}.filterbar button.active{background:#21435d;border-color:#447ca1;color:white}.collections{display:grid;grid-template-columns:repeat(4,1fr);gap:11px}.collection{border:1px solid #223648;background:#0b141e;text-align:left;min-height:162px;position:relative;overflow:hidden;padding:18px;transition:border-color .2s,transform .2s;width:100%;color:inherit;display:flex;flex-direction:column;justify-content:space-between}.collection .idx{font-family:ui-monospace,monospace;color:#6f8aa0;font-size:10px}.collection h3{margin:0 0 8px;font-size:17px;line-height:1.13;letter-spacing:-.025em}.collection p{font-size:11px;line-height:1.45;color:#879caf;margin:0}.collection i{position:absolute;right:-15px;bottom:-21px;font-size:100px;line-height:1;font-style:normal;opacity:.07}.constellation-wrap{border:1px solid #22384c;background:radial-gradient(ellipse at 48% 40%,#13263a 0%,#0b141e 52%,#080e16 100%);display:grid;grid-template-columns:1.3fr 1fr;gap:10px;min-height:300px;overflow:hidden}.constellation-graphic{position:relative;min-height:300px}.constellation-graphic svg{display:block;width:100%;height:100%;min-height:300px}.star-node{cursor:pointer}.star-node circle{transition:fill .2s,r .2s}.star-node:hover circle{fill:#a9e2ff}.crew-detail{padding:37px 25px 20px;border-left:1px solid #254054}.crew-detail h3{font-size:28px;letter-spacing:-.035em;margin:12px 0}.crew-detail p{font-size:13px;color:#9bb0c2;line-height:1.7}.crew-list{display:flex;flex-wrap:wrap;gap:7px;margin-top:15px}.mini-btn{background:#111f2d;border:1px solid #2b485f;color:#99bdd5;border-radius:3px;padding:7px 9px;font-size:10px}.mini-btn:hover{border-color:#8accff}.deep-footer{margin-top:90px;border-top:1px solid #27394b;padding:45px 0;display:flex;justify-content:space-between;gap:25px}.deep-footer b{font-size:24px;letter-spacing:-.045em}.deep-footer p{color:#7892a7;max-width:350px;font-size:12px;margin:10px 0}.deep-footer small{font-size:10px;color:#6e879b;align-self:end}.hidden{display:none!important}.admin{min-height:calc(100vh - 73px);display:grid;grid-template-columns:234px minmax(0,1fr);max-width:1600px;margin:0 auto}.side{border-right:1px solid #253647;padding:32px 15px 30px;background:#090f17}.side-label{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#5d819e;margin:15px 12px 16px}.side button{display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:13px 13px;border:0;background:transparent;color:#849db0;border-radius:6px;font-size:12px;margin-bottom:3px}.side button.active{color:#e4f4ff;background:#173046;border-left:2px solid var(--blue)}.side button:hover:not(.active){background:#111d29;color:#d3e1eb}.side button .symbol{font-size:15px;width:18px;text-align:center}.side-bottom{border-top:1px solid #203040;padding:21px 13px 0;margin-top:30px}.side-bottom p{font-size:11px;color:#8199a9;line-height:1.6}.admin-content{padding:35px clamp(20px,3.2vw,54px) 75px;min-width:0}.admin-head{display:flex;justify-content:space-between;gap:18px;align-items:center;margin-bottom:24px}.admin-head h1{font-size:clamp(31px,3vw,45px);letter-spacing:-.055em;margin:6px 0}.admin-head p{font-size:12px;color:#86a1b5;margin:0}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px}.kpi{background:#0c1621;border:1px solid #22384b;padding:18px;min-height:128px;position:relative}.kpi label{font:10px ui-monospace,monospace;color:#8da7b9;letter-spacing:.1em}.kpi strong{display:block;font-size:39px;letter-spacing:-.05em;font-weight:680;margin-top:11px}.kpi span{position:absolute;right:14px;top:16px;color:#5680a0;font-size:13px}.dash-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:14px;margin-top:14px}.panel{border:1px solid #25384b;background:#0b141e;padding:20px;min-width:0}.panel h3{margin:0;font-size:15px;font-weight:690}.panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;gap:12px}.panel-head .eyebrow{color:#778fa3;font-size:10px}.timeline{display:flex;flex-direction:column;gap:0}.timeline-item{display:grid;grid-template-columns:19px 1fr;gap:12px;padding:0 0 22px}.timeline-item .trace{position:relative;display:flex;justify-content:center}.timeline-item .trace:before{content:"";height:100%;border-left:1px solid #2a495f;position:absolute;top:12px}.timeline-item:last-child .trace:before{display:none}.timeline-item .trace:after{content:"";background:#79bfff;border:3px solid #112336;width:11px;height:11px;border-radius:50%;position:relative;top:3px}.timeline-item h4{font-size:12px;margin:0 0 6px}.timeline-item p{font-size:11px;color:#8198ac;margin:0}.workflow{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.step{border-top:2px solid #4d7391;padding:16px 5px}.step strong{display:block;font-size:11px;margin-bottom:7px}.step span{font-size:10px;color:#819bad}.worklist{display:grid;gap:9px}.workrow{display:flex;gap:12px;align-items:center;justify-content:space-between;border:1px solid #26394a;padding:14px;background:#0e1a25}.workrow:hover{border-color:#477393}.workrow .title{font-size:12px;font-weight:690}.workrow .subtitle{font-size:10px;color:#7d9cb3;margin-top:5px}.workrow .date{font-size:10px;color:#8ea4b3}.searchbox{display:flex;align-items:center;gap:10px;border:1px solid #32495e;background:#0b1722;padding:0 12px;min-height:41px;min-width:190px}.searchbox input{background:none;color:#e7f3fd;outline:0;border:0;font-size:12px;min-width:0;width:100%}.searchbox input::placeholder{color:#688399}.small-notice{background:#101e2a;border-left:2px solid #89c2e5;padding:13px 16px;font-size:12px;color:#a9c3d3;margin-bottom:16px;line-height:1.6}.research-columns{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.research-tile{padding:18px 15px;border:1px solid #283f53;background:#0d1a27;min-height:160px}.research-tile b{display:block;font-size:17px;margin:12px 0 8px}.research-tile p{font-size:11px;color:#8cabc1;line-height:1.6}.ledger{width:100%;border-collapse:collapse;text-align:left}.ledger th{font:10px ui-monospace,monospace;color:#7b9db6;letter-spacing:.09em;padding:15px 12px;border-bottom:1px solid #345066}.ledger td{padding:15px 12px;border-bottom:1px solid #1f3445;font-size:12px;vertical-align:middle}.ledger tr:hover{background:#102030}.production{display:grid;grid-template-columns:1.1fr .9fr;gap:13px}.poster-page{aspect-ratio:3/4;max-height:470px;background:#0a1521;border:1px solid #48637b;position:relative;overflow:hidden;padding:24px;display:flex;flex-direction:column;justify-content:space-between}.poster-page:before{content:"";position:absolute;border:1px solid #2b648d;border-radius:50%;width:310px;height:310px;right:-100px;top:75px;box-shadow:0 0 0 50px rgba(49,94,131,.08),0 0 0 100px rgba(49,94,131,.04)}.poster-page h2{font-size:clamp(30px,5vw,60px);line-height:.99;letter-spacing:-.07em;max-width:280px;position:relative}.poster-page .graphic{height:145px;position:relative;overflow:hidden}.poster-page .graphic svg{position:absolute;left:0;bottom:0;width:100%}.field{display:grid;gap:6px;margin-bottom:15px}.field label{font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:#93b1c4}.field input,.field select,.field textarea{background:#091723;border:1px solid #324b60;color:#e8f5ff;padding:12px 11px;border-radius:4px;width:100%;outline:0;font-size:13px}.field textarea{resize:vertical;min-height:105px}.shadowboard{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.board-column{border:1px solid #253b4c;padding:13px;background:#0a141d}.board-column h3{font-size:12px;color:#aec9dd;margin:5px 0 15px}.board-card{padding:13px;border:1px solid #294155;background:#0f1d29;margin-bottom:9px}.board-card b{display:block;font-size:12px}.board-card p{font-size:11px;color:#8ba5b7;margin:10px 0}.progress-track{height:5px;background:#203a4c;overflow:hidden;border-radius:4px}.progress-track>span{display:block;height:100%;background:#7acbff;width:24.24%}.backdrop{position:fixed;inset:0;z-index:40;background:#02060bbd;display:grid;place-items:center;padding:15px;backdrop-filter:blur(8px)}.modal{background:#0c1722;border:1px solid #3b5a73;width:min(600px,100%);padding:24px;max-height:90vh;overflow:auto;box-shadow:0 35px 100px #000b}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;gap:10px}.modal h2{margin:3px 0 0;font-size:27px;letter-spacing:-.04em}.close{background:none;border:1px solid #38516a;border-radius:4px;color:white;padding:5px 10px;font-size:18px}.modal-actions{display:flex;justify-content:end;gap:10px;flex-wrap:wrap}.toast{position:fixed;bottom:24px;right:22px;padding:14px 17px;background:#153249;border:1px solid #4d83a5;color:#d9eeff;z-index:70;font-size:12px;max-width:320px;box-shadow:0 12px 35px #0009}.collection-detail{display:grid;gap:12px}.collection-detail h3{font-size:20px;margin:0}.collection-detail p{color:#9aafbf;font-size:13px;margin:0}.dot{background:#85d7af;width:7px;height:7px;display:inline-block;border-radius:50%;margin-right:8px}.footer-note{color:#6f8ca1;font-size:10px;margin-top:18px;line-height:1.5}@keyframes spin{to{transform:rotate(360deg)}}@keyframes pulse{50%{opacity:.4}}@media(max-width:1100px){.top-center{display:none}.collections{grid-template-columns:repeat(3,1fr)}.kpis{grid-template-columns:repeat(2,1fr)}.story-layout{grid-template-columns:1fr 1fr}.story.primary{grid-column:span 2}.side{padding:26px 8px}.admin{grid-template-columns:186px 1fr}.research-columns{grid-template-columns:repeat(2,1fr)}}@media(max-width:720px){.topbar{padding:0 15px;height:64px}.brand{min-width:0;gap:8px}.brand-name{font-size:11px}.brand small{font-size:8px}.mark{height:31px;width:31px;flex-shrink:0}.switch{padding:8px 9px;font-size:9px}.portal{padding:0 18px 50px}.hero{grid-template-columns:1fr;min-height:auto}.hero-left{padding:55px 0 0}.hero h1{font-size:clamp(51px,12vw,88px)}.hero-art{height:250px}.orbital{width:300px}.number-ruler{margin-bottom:38px}.section{margin-top:45px}.section-head{display:block}.section-head p{margin-top:11px}.story-layout,.collections,.constellation-wrap,.dash-grid,.production,.shadowboard{grid-template-columns:1fr}.story.primary{grid-column:auto}.story{min-height:220px}.collection{min-height:130px}.crew-detail{border-left:0;border-top:1px solid #254054;padding:20px}.constellation-graphic{min-height:250px}.constellation-graphic svg{min-height:250px}.admin{display:block}.side{display:flex;overflow:auto;padding:9px 14px;gap:4px;position:sticky;top:64px;z-index:9;white-space:nowrap;border-right:0;border-bottom:1px solid var(--line);background:#0a121c}.side-label,.side-bottom{display:none}.side button{flex:0 0 auto;width:auto;margin:0;padding:9px 12px;font-size:10px;gap:7px}.side button .symbol{width:auto}.admin-content{padding:24px 15px 65px}.admin-head{flex-wrap:wrap}.kpis{grid-template-columns:repeat(2,1fr)}.kpi strong{font-size:31px}.workrow{flex-wrap:wrap}.research-columns{grid-template-columns:1fr 1fr}.ledger-wrap{overflow:auto}.ledger{min-width:600px}.deep-footer{display:block}.deep-footer small{display:block;margin-top:25px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;scroll-behavior:auto!important;transition:none!important}}
</style>
</head>
<body>
<header class="topbar"><a class="brand" href="#" id="brandHome" aria-label="MoonWitness Portal"><div class="mark" aria-hidden="true"></div><div><div class="brand-name">MOONWITNESS</div><small>THE UNIVERSE / SYSTEM 01</small></div></a><nav class="top-center" aria-label="Portal navigation"><a class="top-link" href="#stories">Stories</a><a class="top-link" href="#worlds">Universes</a><a class="top-link" href="#crew">Crew</a><a class="top-link" href="#archive">Archive</a></nav><div class="switcher" aria-label="Tampilan"><button class="switch active" id="portalSwitch" aria-pressed="true">PORTAL</button><button class="switch" id="shadowSwitch" aria-pressed="false">SHADOW / ADMIN</button></div></header>
<main id="portal" class="portal"><section class="hero"><div class="hero-left"><div class="hero-meta mono"><span><span class="small-dot"></span> SIGNAL DETECTED</span><span>TRANSMISSION / 001</span></div><h1>WHEN THE<br><span>MOON</span><br>WITNESS.</h1><div class="hero-kicker">WE SHARE A MESSAGE.</div><p class="hero-desc">An interconnected universe of witnesses, stories, research, riddles, characters, music and beautifully strange transmissions.</p><div class="hero-actions"><a class="btn" href="#stories">EXPLORE THE SIGNAL &nbsp;↗</a><a class="btn btn-secondary" href="#worlds">THE COLLECTIONS &nbsp;→</a></div></div><div class="hero-art" aria-hidden="true"><svg class="orbital" viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="250" cy="250" r="180" stroke="#244158" stroke-width=".7"/><circle cx="250" cy="250" r="137" stroke="#315778" stroke-width=".8" stroke-dasharray="3 8"/><circle cx="250" cy="250" r="91" stroke="#274762" stroke-width="1"/><g class="orbit-slow"><ellipse cx="250" cy="250" rx="242" ry="91" transform="rotate(-35 250 250)" stroke="#3B749C" stroke-width=".8"/><circle cx="74" cy="165" r="4" fill="#91D8FF"/></g><g class="orbit-reverse"><ellipse cx="250" cy="250" rx="220" ry="157" transform="rotate(51 250 250)" stroke="#244c65" stroke-width=".8"/><circle cx="423" cy="119" r="3" fill="#9acbf2"/></g><circle cx="250" cy="250" r="80" fill="#112236" stroke="#417393" stroke-width="1"/><path d="M271 177A74 74 0 1 0 271 323A65 65 0 1 1 271 177Z" fill="#99D7FF" class="orbit-pulse"/><circle cx="250" cy="250" r="217" stroke="#1b374d" stroke-width=".8" stroke-dasharray="1 8"/><path d="M30 250H470M250 20V480" stroke="#29445b" stroke-width=".7" stroke-dasharray="2 9"/><path d="M17 330L110 330L155 280L196 362L238 181L280 309L320 289L380 289L422 250L490 250" stroke="#64baf3" stroke-width="1" opacity=".55"/><circle cx="238" cy="181" r="4" fill="#c6eeff"/><circle cx="422" cy="250" r="3" fill="#8fcfff"/></svg></div></section><div class="number-ruler"><div class="ruler-item"><strong id="statCollections">12</strong><span>Collection worlds</span></div><div class="ruler-item"><strong>01</strong><span>Connected universe</span></div><div class="ruler-item"><strong>33</strong><span>Bug slots / mission concept</span></div><div class="ruler-item"><strong>∞</strong><span>Unfinished questions</span></div></div>
<section id="stories" class="section"><div class="section-head"><div><span class="eyebrow">01 / DISCOVER THE SIGNAL</span><h2>Latest transmissions</h2></div><p>Potongan kisah, refleksi dan episode dalam format editorial. Detail tetap diberi label sesuai jenis materinya.</p></div><div class="story-layout" id="storyCards"></div></section>
<section id="worlds" class="section"><div class="section-head"><div><span class="eyebrow">02 / THE STORY WORLDS</span><h2>One universe. Many signals.</h2></div><p>Setiap dunia memiliki arsip dan identitas sendiri, tetapi semuanya terhubung melalui satu sistem editorial.</p></div><div class="filterbar" id="collectionFilters"></div><div class="collections" id="collectionGrid"></div></section>
<section id="crew" class="section"><div class="section-head"><div><span class="eyebrow">03 / ME AND MY CREW</span><h2>Crew constellation</h2></div><p>THE SHADOW menjadi simpul naratif pusat. Garis menghubungkan karakter dalam satu indeks universe, bukan menyatakan hubungan nyata.</p></div><div class="constellation-wrap"><div class="constellation-graphic"><svg viewBox="0 0 620 360" role="img" aria-label="Peta simpul karakter MoonWitness"><g stroke="#365f7c" stroke-width="1" opacity=".75"><path d="M305 180L84 80 M305 180L195 47 M305 180L474 63 M305 180L538 169 M305 180L436 302 M305 180L177 296 M305 180L71 210 M305 180L365 30"/></g><circle cx="305" cy="180" r="62" fill="none" stroke="#3d7394" stroke-dasharray="3 7"/><circle cx="305" cy="180" r="39" fill="#112a3b" stroke="#8ad6ff"/><text x="305" y="177" font-size="12" text-anchor="middle" fill="#e4f5ff" font-weight="700">THE</text><text x="305" y="191" font-size="12" text-anchor="middle" fill="#e4f5ff" font-weight="700">SHADOW</text><g id="svgCrew"></g></svg></div><div class="crew-detail"><span class="eyebrow">CHARACTER REGISTRY / 00</span><h3 id="crewName">THE SHADOW</h3><div id="crewAlias" class="tag">PRIMARY NARRATIVE NODE</div><p id="crewDescription">Karakter pusat universe dan simpul narasi. Identitas ditampilkan melalui cahaya, siluet, dan garis—bukan potret wajah.</p><div class="crew-list" id="crewMiniButtons"></div></div></div></section>
<section id="archive" class="section"><div class="section-head"><div><span class="eyebrow">04 / FOLLOW THE EVIDENCE</span><h2>The witness protocol.</h2></div><p>Pengamatan dan klaim faktual tidak otomatis menjadi kebenaran. Sumber, penafsiran, dan fiksi mempunyai jalur berbeda.</p></div><div class="research-columns"><div class="research-tile"><span class="eyebrow">STEP 01</span><b>OBSERVE</b><p>Catat peristiwa atau ide apa adanya. Simpan waktu, konteks, dan sumber awal.</p></div><div class="research-tile"><span class="eyebrow">STEP 02</span><b>REMEMBER</b><p>Simpan arsip, versi narasi, karakter, dan keterkaitan antar episode.</p></div><div class="research-tile"><span class="eyebrow">STEP 03</span><b>VERIFY</b><p>Bedakan ayat/sumber, terjemahan, tafsir, klaim, dan metafora.</p></div><div class="research-tile"><span class="eyebrow">STEP 04</span><b>TELL</b><p>Terbitkan cerita, riset, atau poster dengan konteks dan label yang jelas.</p></div></div></section>
<footer class="deep-footer"><div><b>WHEN THE MOON WITNESS,<br>WE SHARE A MESSAGE.</b><p>A world of storytelling, observation, curiosity, correction and creative transmission.</p></div><small>MOONWITNESS / DEMONSTRATION PROTOTYPE<br>All published and editorial actions are local demo only.</small></footer></main>
<div id="admin" class="admin hidden"><aside class="side" aria-label="SHADOW modules"><div class="side-label">THE SHADOW / NAVIGATION</div><button data-admin="overview" class="active"><span class="symbol">◈</span> Overview</button><button data-admin="studio"><span class="symbol">✎</span> Story Studio</button><button data-admin="signals"><span class="symbol">⌁</span> Signal Ledger</button><button data-admin="research"><span class="symbol">⌘</span> Corpus & Mizan</button><button data-admin="posters"><span class="symbol">▤</span> Poster Forge</button><button data-admin="registry"><span class="symbol">◉</span> Crew Registry</button><button data-admin="board"><span class="symbol">≡</span> Advisory Board</button><button data-admin="archive"><span class="symbol">▦</span> Archive</button><div class="side-bottom"><div class="eyebrow"><span class="dot"></span> DEMO MODE</div><p>Workspace konseptual. Belum ada autentikasi, basis data server, atau publikasi online.</p></div></aside><div class="admin-content" id="adminContent"></div></div>
<div class="backdrop hidden" id="modalBackdrop" role="dialog" aria-modal="true" aria-labelledby="modalHeading"><div class="modal"><div class="modal-head"><div><span class="eyebrow" id="modalEyebrow">SHADOW / WORKSPACE</span><h2 id="modalHeading">New transmission</h2></div><button class="close" id="modalClose" aria-label="Tutup">×</button></div><div id="modalBody"></div></div></div><div id="toast" class="toast hidden" role="status"></div>
<script>
const collections=[
{id:'moonwitness',name:'MOONWITNESS',category:'Stories',desc:'Witness · clock event · Thunderstruck · Menggigil · Kado.',symbol:'☾'},
{id:'allah',name:'ALLAH–PROMISE',category:'Research',desc:'High Hopes · Al-Husnayain · divine names · positive correction.',symbol:'✧'},
{id:'batteries',name:'THE BATTERIES',category:'Comics',desc:'A-L4H · Baby-Doll · Walter-Whiter · absurd electric chaos.',symbol:'ϟ'},
{id:'npd',name:'NPD TEAM',category:'Comics',desc:'Tarian Hujan · Tarian Kids · missions · music-driven comics.',symbol:'♫'},
{id:'ridley',name:'MOONRIDLEY',category:'Riddles',desc:'Take It Off · teka-teki · A Place · lagu dan petunjuk.',symbol:'?'},
{id:'pendeta',name:'PENDETA–ONLINE',category:'Research',desc:'Elohim · Adonai · YHWH · Hashem · interpretive studies.',symbol:'⌘'},
{id:'sinter',name:'SINTERCLASS',category:'Research',desc:'Hinduism · Buddhism · tradisi dan studi perbandingan.',symbol:'◇'},
{id:'zill',name:'ZILL',category:'Research',desc:'Tasawuf · tarekat · ahli zikir · pelurusan dan rekonsiliasi.',symbol:'✺'},
{id:'reza',name:'RE–ZA / NAME',category:'Stories',desc:'Nama dan identitas · RA–SOUL · Rasul · refleksi etimologi.',symbol:'⟡'},
{id:'xii',name:'MOONWITNESS XII',category:'Missions',desc:'The Batteries · 33 Bugs · submission master ledger.',symbol:'Ⅻ'},
{id:'honey',name:'HONEY & MOON',category:'Stories',desc:'Chasing Heart · Lovestruck · cerita romantis absurd.',symbol:'♡'},
{id:'rock',name:'ROCKSOUL / 1·6·3',category:'Research',desc:'Monocentric foundation · four pillars · soul loop.',symbol:'◎'}];
const stories=[{id:'T001',collection:'moonwitness',name:'TICK–TOCK ON THE CLOCK',short:'Jam berhenti, lalu kembali terdengar. Kebahagiaan kadang sesederhana detik yang berdetak.',type:'STORY / OBSERVATION',date:'06 OCT 2026'},
{id:'T002',collection:'moonwitness',name:'THUNDERSTRUCK',short:'Wahyu, Wahyono, dan sebuah istilah yang berubah menjadi kisah mimpi berenergi listrik.',type:'DREAM / STORY',date:'30 SEP 2026'},
{id:'T003',collection:'xii',name:'CHAOS MEDIC · PATCH IT BRO!',short:'MOONWITNESS XII — 33 Bugs. Laporan submission dipisahkan dari bukti verifikasi.',type:'MISSION / LEDGER',date:'14 OCT 2026'}];
const crew=[{name:'THE SHADOW',alias:'PRIMARY NARRATIVE NODE',desc:'Simpul narasi universe. Ditampilkan sebagai identitas simbolis: siluet, garis, cahaya, sinyal dan arsip.',x:305,y:180},{name:'THE BATTERY',alias:'A-L4H / THE BOSS',desc:'Karakter fiksi absurd yang membawa motif energi, kejutan, teknologi, dan electric comedy.',x:84,y:80},{name:'DOGS FROM UNIVERSE',alias:'MOH571 / THE STARS',desc:'Karakter konseptual bertema kosmos, sinyal yang menghilang, dan perjalanan naratif.',x:195,y:47},{name:'THE BLUE WITCH',alias:'BLUE EYES',desc:'Simbol karakter dengan signature cahaya biru dan misteri.',x:474,y:63},{name:'DJ DAVID',alias:'SOUND / FREQUENCY',desc:'Representasi ritme, musik, frekuensi dan waveform.',x:538,y:169},{name:'WALTER–WHITER',alias:'CHAOS MEDIC',desc:'Tokoh dokter absurd bergaya komik; identitas visual menggunakan geometri teknis.',x:436,y:302},{name:'BABY–DOLL',alias:'NPD TEAM / CREW',desc:'Karakter simbolis dalam cerita THE BATTERIES dan produksi NPD TEAM.',x:177,y:296},{name:'ELECTRIC FOREST',alias:'ORGANIC SIGNAL',desc:'Jaringan hutan, akar, dan lintasan energi di universe.',x:71,y:210},{name:'INDESTRUCTIBLE',alias:'THE RED FIRE',desc:'Motif daya tahan, energi merah dan efek benturan.',x:365,y:30}];
const storageKey='moonwitness-shadow-drafts-v1';let drafts=[];try{drafts=JSON.parse(localStorage.getItem(storageKey)||'[]');if(!Array.isArray(drafts))drafts=[]}catch(e){drafts=[]}let mode='portal',section='overview',category='All',selectedCrew=0,searchTerm='';const $=s=>document.querySelector(s);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function saveDrafts(){try{localStorage.setItem(storageKey,JSON.stringify(drafts))}catch(e){showToast('Penyimpanan browser tidak tersedia')}}function showToast(msg){const t=$('#toast');t.textContent=msg;t.classList.remove('hidden');clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>t.classList.add('hidden'),3400)}
function setMode(next){mode=next;$('#portal').classList.toggle('hidden',next!=='portal');$('#admin').classList.toggle('hidden',next!=='shadow');$('#portalSwitch').classList.toggle('active',next==='portal');$('#shadowSwitch').classList.toggle('active',next==='shadow');$('#portalSwitch').setAttribute('aria-pressed',String(next==='portal'));$('#shadowSwitch').setAttribute('aria-pressed',String(next==='shadow'));if(next==='shadow')renderAdmin();window.scrollTo({top:0,behavior:'instant'});}
function renderPortal(){const published=drafts.filter(d=>d.status==='PUBLISHED').slice(0,2).map(d=>({id:'D'+d.id,collection:d.collection,name:d.title,short:d.summary||'New editorial transmission.',type:'PUBLISHED DEMO',date:'LOCAL PREVIEW'}));let items=[...published,...stories].slice(0,3);$('#storyCards').innerHTML=items.map((s,i)=>`<button type="button" class="story ${i===0?'primary':''}" data-story="${esc(s.id)}"><div class="id mono"><span>${esc(s.type)}</span><span>${esc(s.date)}</span></div><div><h3>${esc(s.name)}</h3><p>${esc(s.short)}</p></div><div class="story-foot"><span class="tag">${esc(collections.find(c=>c.id===s.collection)?.name||'STORY')}</span><span>OPEN TRANSMISSION ↗</span></div></button>`).join('');$('#collectionFilters').innerHTML=['All','Stories','Comics','Research','Riddles','Missions'].map(c=>`<button type="button" data-filter="${c}" class="${c===category?'active':''}">${c.toUpperCase()}</button>`).join('');const list=collections.filter(c=>category==='All'||c.category===category);$('#collectionGrid').innerHTML=list.map((c,i)=>`<button type="button" class="collection" data-collection="${c.id}"><div class="idx">WORLD / ${String(collections.indexOf(c)+1).padStart(2,'0')} <span style="float:right;color:#7eb3d7">↗</span></div><div><h3>${esc(c.name)}</h3><p>${esc(c.desc)}</p></div><i aria-hidden="true">${esc(c.symbol)}</i></button>`).join('');$('#statCollections').textContent=collections.length;renderCrew();}
function renderCrew(){const c=crew[selectedCrew];$('#crewName').textContent=c.name;$('#crewAlias').textContent=c.alias;$('#crewDescription').textContent=c.desc;$('#svgCrew').innerHTML=crew.slice(1).map((n,i)=>`<g role="button" tabindex="0" aria-label="${esc(n.name)}" data-crewnode="${i+1}" class="star-node"><circle cx="${n.x}" cy="${n.y}" r="11" fill="#1d4057" stroke="#8acfff" stroke-width="1"/><circle cx="${n.x}" cy="${n.y}" r="3" fill="#d0f2ff"/><text x="${n.x}" y="${n.y+24}" text-anchor="middle" fill="#8eb2cc" font-family="monospace" font-size="9">${esc(n.name)}</text></g>`).join('');$('#crewMiniButtons').innerHTML=crew.slice(0,5).map((c,i)=>`<button class="mini-btn" data-crew="${i}">${esc(c.name)}</button>`).join('');}
function heading(eye,title,description,actions=''){return `<div class="admin-head"><div><div class="eyebrow">${eye}</div><h1>${title}</h1><p>${description}</p></div>${actions}</div>`}
function workrow(item,i){return `<div class="workrow"><div><div class="title">${esc(item.title)}</div><div class="subtitle">${esc(collections.find(c=>c.id===item.collection)?.name||'CUSTOM')} · ${esc(item.type||'STORY')}</div></div><div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap"><span class="tag ${item.status==='PUBLISHED'?'green':'amber'}">${esc(item.status)}</span>${item.id?`<button class="btn btn-tiny btn-secondary" data-edit="${item.id}">OPEN ↗</button>`:''}</div></div>`}
function renderAdmin(){document.querySelectorAll('[data-admin]').forEach(b=>b.classList.toggle('active',b.dataset.admin===section));const root=$('#adminContent');let html='';const newBtn='<button class="btn" data-new="true">+ NEW TRANSMISSION</button>';
if(section==='overview'){html=heading('01 / SHADOW COMMAND','Mission control','Unified overview · contoh workspace editorial, bukan data produksi langsung.',newBtn)+`<div class="kpis"><div class="kpi"><label>UNIVERSE COLLECTIONS</label><strong>12</strong><span>◈</span></div><div class="kpi"><label>MISSION SLOT</label><strong>33</strong><span>◉</span></div><div class="kpi"><label>RECORDED SUBMISSIONS</label><strong>08</strong><span>⌁</span></div><div class="kpi"><label>LOCAL DRAFTS</label><strong>${drafts.length.toString().padStart(2,'0')}</strong><span>▤</span></div></div><div class="small-notice"><b>Editorial principle:</b> DOCUMENT FIRST · INTERPRET LATER. Status “approved” dalam arsip submission adalah <b>status yang dilaporkan dalam naskah</b>, bukan verifikasi persetujuan ilahi.</div><div class="dash-grid"><div class="panel"><div class="panel-head"><h3>Transmission log</h3><span class="eyebrow">RECENT STORY RECORDS</span></div><div class="timeline"><div class="timeline-item"><div class="trace"></div><div><h4>CHAOS MEDIC — MOONWITNESS XII</h4><p>14 OCT 2026 / MASTER SUBMISSION / 8 of 33 entries captured</p></div></div><div class="timeline-item"><div class="trace"></div><div><h4>TICK–TOCK ON THE CLOCK</h4><p>06 OCT 2026 / PERSONAL STORY / clock restored</p></div></div><div class="timeline-item"><div class="trace"></div><div><h4>MOONWITNESS — THUNDERSTRUCK</h4><p>30 SEP 2026 / DREAM STORY / narrative observation</p></div></div></div></div><div class="panel"><div class="panel-head"><h3>Editorial protocol</h3><span class="eyebrow">WORKFLOW</span></div><div class="workflow"><div class="step"><strong>CAPTURE</strong><span>Signals</span></div><div class="step" style="border-color:#ddb779"><strong>VERIFY</strong><span>Sources</span></div><div class="step" style="border-color:#b68cdb"><strong>DESIGN</strong><span>Pages</span></div><div class="step" style="border-color:#78cda7"><strong>PUBLISH</strong><span>Archive</span></div></div><div style="margin-top:24px" class="eyebrow">STATUS / SUBMISSIONS (REPORTED)</div><p style="font-size:28px;margin:7px 0 9px;letter-spacing:-.04em">08 <span class="muted" style="font-size:15px">/ 33</span></p><div class="progress-track"><span></span></div><p style="font-size:11px;color:#789bb4">Remaining: 25 unspecified. No new items invented.</p></div></div><div class="dash-grid"><div class="panel"><div class="panel-head"><h3>Active editor queue</h3><button class="btn btn-secondary btn-tiny" data-go="studio">ALL STORIES →</button></div><div class="worklist">${drafts.length?drafts.slice(0,4).map(workrow).join(''):'<p class="soft" style="font-size:12px">No local drafts yet. Create a transmission to start.</p>'}</div></div><div class="panel"><div class="panel-head"><h3>Research foundations</h3><button class="btn btn-secondary btn-tiny" data-go="research">OPEN CORPUS →</button></div><p style="font-size:12px;color:#93acc0;line-height:1.8">CORPUS → EVIDENCE → MIZAN → LEDGER → EDITORIAL REVIEW. Separate source quotation, translation, commentary, personal interpretation, fiction and reported experience.</p></div></div>`;}
else if(section==='studio'){html=heading('02 / CONTENT ENGINE','Story studio','Create, review, categorize and locally preview MoonWitness transmissions.',newBtn)+`<div class="panel"><div class="panel-head"><h3>Local editorial drafts</h3><span class="eyebrow">${drafts.length} ENTRIES</span></div><div class="worklist">${drafts.length?drafts.map(workrow).join(''):'<div class="small-notice">Belum ada draft lokal. Klik NEW TRANSMISSION untuk membuat contoh episode.</div>'}</div></div><div class="dash-grid"><div class="panel"><h3 style="margin-bottom:18px">Series structure</h3><div class="worklist">${collections.slice(0,6).map(c=>`<div class="workrow"><div><div class="title">${esc(c.name)}</div><div class="subtitle">${esc(c.desc)}</div></div><span class="tag">${esc(c.category)}</span></div>`).join('')}</div></div><div class="panel"><h3>Episode format</h3><p style="font-size:12px;color:#98b2c6;line-height:2">Universe → Collection → Season / Arc → Episode → Scene → Page → Asset<br><br>Fields: narrative text, narrator, witness, events, date, character, classification, citations, claims, page artwork, version, status.</p></div></div>`;}
else if(section==='signals'){html=heading('03 / STORY & MISSION LOG','Signal ledger','A chronology of recorded story signals and mission submissions.')+`<div class="small-notice">Eight submissions are recorded in the earlier creative project. Their labels are <b>reported statuses</b> in a personal submission table, not independently validated outcomes.</div><div class="panel ledger-wrap"><table class="ledger"><thead><tr><th>TRANSMISSION</th><th>TYPE</th><th>STATUS</th><th>REFERENCE</th></tr></thead><tbody><tr><td>MW-XII-001 — AEGIS PROTECTION</td><td>Submission</td><td><span class="tag green">REPORTED APPROVED</span></td><td>Master table</td></tr><tr><td>MW-XII-002 — LONG LIFE TARGET</td><td>Submission</td><td><span class="tag green">REPORTED APPROVED</span></td><td>100+ year request</td></tr><tr><td>MW-XII-003 … 006</td><td>Submissions</td><td><span class="tag green">REPORTED APPROVED</span></td><td>Details: in source manuscript</td></tr><tr><td>MW-XII-007</td><td>Submission</td><td><span class="tag amber">REPORTED CONDITIONAL</span></td><td>Master table</td></tr><tr><td>MW-XII-008</td><td>Submission</td><td><span class="tag purple">SUBMITTED</span></td><td>Kun Fayakun · Isa · Maryam</td></tr><tr><td>MW-XII-009 … 033</td><td>Unrecorded slots</td><td><span class="tag">UNRECORDED</span></td><td>No speculative data</td></tr></tbody></table></div>`;}
else if(section==='research'){const parts=[['CORPUS','Original source text, manuscript, reference, historical context.'],['EVIDENCE','Verses, editions, independent references and directly observed facts.'],['MIZAN','Cross-check, translation, commentary, alternative interpretation.'],['LEDGER','Conclusion, uncertainty, editorial status and correction history.']];html=heading('04 / RESEARCH ENGINE','Corpus & Mizan','Source-aware research, with independent factual and creative layers.')+`<div class="small-notice">Document first, interpret later. Do not treat a symbolic story, private dream, or stylistic reinterpretation as established historical or divine fact.</div><div class="research-columns">${parts.map((p,i)=>`<div class="research-tile"><span class="eyebrow">LAYER ${String(i+1).padStart(2,'0')}</span><b>${p[0]}</b><p>${p[1]}</p></div>`).join('')}</div><div class="dash-grid"><div class="panel"><h3>Core research series</h3><div class="worklist" style="margin-top:17px">${collections.filter(c=>c.category==='Research').map(c=>`<div class="workrow"><div><div class="title">${esc(c.name)}</div><div class="subtitle">${esc(c.desc)}</div></div><span class="tag">RESEARCH</span></div>`).join('')}</div></div><div class="panel"><h3>Classification rules</h3><p style="font-size:12px;color:#a2bbcb;line-height:2">SOURCE QUOTATION<br>TRANSLATION<br>TEXTUAL INTERPRETATION<br>PERSONAL WITNESS<br>FICTION / PARODY<br>HYPOTHESIS / UNVERIFIED<br>EDITORIAL CORRECTION</p><p style="font-size:11px;color:#7fa8c3">Respect sacred representation constraints. Preserve full quotations when permitted and verify against authoritative sources before publishing.</p></div></div>`;}
else if(section==='posters'){html=heading('05 / VISUAL STORY ENGINE','Poster forge','Manga lines · futuristic editorial · one page, one image, one file.')+`<div class="production"><div class="poster-page"><div class="eyebrow">MOONWITNESS / VISUAL SYSTEM</div><div><h2>THE<br>BATTERIES<br><span style="color:#80caff">TRANSMIT.</span></h2><div class="graphic"><svg viewBox="0 0 420 150"><g stroke="#70c8ff" stroke-width="2" fill="none"><path d="M0 125L70 125L110 60L151 131L201 20L237 111L300 111L345 44L420 44"/><path d="M0 144L75 144L119 83L175 150L208 43L248 130L320 130L361 65L420 65" opacity=".4"/></g></svg></div></div><div class="mono" style="font-size:10px;color:#82a7c2">SAMPLE LAYOUT · FACELESS · TYPOGRAPHY / LINES / SIGNAL</div></div><div class="panel"><h3>Production specification</h3><p style="font-size:12px;line-height:2;color:#91abbe">1 PAGE = 1 IMAGE = 1 FILE<br>Visible page numbering<br>Consistent character silhouette<br>No visible character faces<br>Manga line effects, electric signal<br>Typography readable, not cut off<br>Keep religious references respectful<br>Source text distinct from dramatic dialogue</p><div style="margin-top:26px"><label class="eyebrow" for="pages">PAGE COUNT PLANNER</label><select id="pages" style="margin-top:11px;background:#122436;color:#eff8ff;padding:11px;width:100%;border:1px solid #35536d"><option>4 pages / arc</option><option>6 pages / arc</option><option>12 pages / arc</option><option>Custom per story</option></select><p class="footer-note">This prototype shows production requirements. It does not yet generate image files.</p></div></div></div>`;}
else if(section==='registry'){html=heading('06 / CHARACTER INDEX','Crew registry','Characters, fictional aliases, motifs and story references.')+`<div class="small-notice">Crew entries are fictional universe metadata. A character alias is not proof of a real identity or historical relationship.</div><div class="collections" style="grid-template-columns:repeat(auto-fit,minmax(210px,1fr))">${crew.map((c,i)=>`<button class="collection" data-admincrew="${i}"><div class="idx">CREW / ${String(i).padStart(2,'0')}</div><div><h3>${esc(c.name)}</h3><p>${esc(c.alias)}</p></div><i aria-hidden="true">✧</i></button>`).join('')}</div>`;}
else if(section==='board'){html=heading('07 / DECISION & CHANGE','Advisory board','Editorial issue management with traceable decisions and unresolved questions.')+`<div class="shadowboard"><div class="board-column"><h3>01 / SIGNALS TO REVIEW</h3><div class="board-card"><b>ZILL research</b><p>Verify citations and distinguish Sufi practice from editorial interpretation.</p><span class="tag amber">CHECK SOURCES</span></div><div class="board-card"><b>RE–ZA etymology</b><p>Keep Egyptian linguistic facts separate from fictional wordplay.</p><span class="tag amber">CROSS CHECK</span></div></div><div class="board-column"><h3>02 / IN DESIGN</h3><div class="board-card"><b>NPD TEAM — episode artwork</b><p>Comic panels, soundtrack context, faceless cast, clear typography.</p><span class="tag purple">PRODUCTION</span></div><div class="board-card"><b>HIGH HOPES / 6 posters</b><p>Maintain references, source boundaries and visual style.</p><span class="tag purple">PRODUCTION</span></div></div><div class="board-column"><h3>03 / ARCHIVE CONTROL</h3><div class="board-card"><b>Clock / Tick–tock</b><p>Story date and repair chronology recorded.</p><span class="tag green">STORY RECORDED</span></div><div class="board-card"><b>MOONWITNESS XII</b><p>8 of 33 recorded; remaining slots left unrecorded.</p><span class="tag">PARTIAL LEDGER</span></div></div></div>`;}
else if(section==='archive'){html=heading('08 / RETRIEVAL SYSTEM','Universe archive','Search collections, locally published demos, and preserved story records.')+`<div class="panel"><div class="panel-head"><h3>Archive index</h3><label class="searchbox">⌕ <input id="archiveSearch" placeholder="Search collections / titles" aria-label="Cari arsip" value="${esc(searchTerm)}"></label></div><div id="archiveResults" class="worklist"></div></div>`;}
root.innerHTML=html;if(section==='archive'){const inp=$('#archiveSearch');inp.addEventListener('input',e=>{searchTerm=e.target.value;renderArchiveRows();});renderArchiveRows();}}
function renderArchiveRows(){const q=searchTerm.toLowerCase().trim();const base=collections.map(c=>({title:c.name,subtitle:c.desc,status:'COLLECTION',category:c.id}));const entries=stories.map(s=>({title:s.name,subtitle:s.short,status:'STORY',category:s.collection}));const custom=drafts.map(d=>({title:d.title,subtitle:d.summary,status:d.status,category:d.collection}));const matches=[...custom,...entries,...base].filter(i=>(i.title+' '+i.subtitle).toLowerCase().includes(q));$('#archiveResults').innerHTML=matches.length?matches.map(i=>`<div class="workrow"><div><div class="title">${esc(i.title)}</div><div class="subtitle">${esc(i.subtitle)}</div></div><span class="tag">${esc(i.status)}</span></div>`).join(''):'<p class="soft">No matching records.</p>'}
function showModal(title,body,eye='TRANSMISSION'){ $('#modalHeading').textContent=title;$('#modalEyebrow').textContent=eye;$('#modalBody').innerHTML=body;$('#modalBackdrop').classList.remove('hidden');$('#modalClose').focus()}function closeModal(){$('#modalBackdrop').classList.add('hidden')}
function draftModal(id){const d=drafts.find(x=>String(x.id)===String(id));showModal(d?'Edit transmission':'New transmission',`<form id="draftForm"><input type="hidden" name="id" value="${esc(d?.id||'')}"><div class="field"><label for="draftTitle">Episode title</label><input id="draftTitle" name="title" required maxlength="110" placeholder="e.g. MOONWITNESS — NEW SIGNAL" value="${esc(d?.title||'')}"></div><div class="field"><label for="draftCollection">Collection</label><select name="collection" id="draftCollection">${collections.map(c=>`<option value="${c.id}" ${d?.collection===c.id?'selected':''}>${esc(c.name)}</option>`).join('')}</select></div><div class="field"><label for="draftType">Classification</label><select name="type" id="draftType">${['STORY','OBSERVATION','RESEARCH','FICTION','RIDDLE','MISSION','COMIC'].map(v=>`<option ${d?.type===v?'selected':''}>${v}</option>`).join('')}</select></div><div class="field"><label for="draftSummary">Short description</label><textarea id="draftSummary" name="summary" maxlength="450" placeholder="Write the signal summary...">${esc(d?.summary||'')}</textarea></div><p class="footer-note">Simpan di browser ini saja. PUBLISH DEMO menampilkannya pada Portal lokal, bukan secara online.</p><div class="modal-actions"><button type="button" class="btn btn-secondary" id="saveDraft" >SAVE DRAFT</button><button type="submit" class="btn">PUBLISH DEMO →</button></div></form>`,'STORY STUDIO / LOCAL DATA');$('#draftTitle').focus();}
function submitDraft(publish){const form=$('#draftForm');if(!form.reportValidity())return;const data=new FormData(form);const rawId=String(data.get('id'));const id=rawId||String(Date.now());const d={id,title:String(data.get('title')).trim(),collection:String(data.get('collection')),type:String(data.get('type')),summary:String(data.get('summary')).trim(),status:publish?'PUBLISHED':'DRAFT'};const index=drafts.findIndex(x=>String(x.id)===String(id));if(index>=0)drafts[index]=d;else drafts.unshift(d);saveDrafts();closeModal();renderPortal();renderAdmin();showToast(publish?'Published to local Portal preview':'Draft saved in this browser');}
function openCollection(id){const c=collections.find(x=>x.id===id);if(!c)return;const related=stories.filter(s=>s.collection===id).map(s=>`<div class="workrow"><div class="title">${esc(s.name)}</div><span class="tag">${esc(s.type)}</span></div>`).join('');showModal(c.name,`<div class="collection-detail"><span class="tag">${esc(c.category.toUpperCase())}</span><p>${esc(c.desc)}</p><h3>Archive structure</h3><p>Collection → Episode → Scene / Page → Media → Reference → Revision. Narrative and factual records are tracked separately.</p>${related||'<p class="muted">Episode details can be added from SHADOW / Story Studio.</p>'}<button class="btn btn-secondary" id="modalToShadow">OPEN SHADOW WORKSPACE →</button></div>`,'WORLD / COLLECTION');}
function openStory(id){const s=stories.find(x=>x.id===id);if(!s){const d=drafts.find(x=>'D'+x.id===id);if(d)showModal(d.title,`<span class="tag">LOCAL DEMO</span><p class="soft">${esc(d.summary||'No summary')}</p><p class="footer-note">Class: ${esc(d.type)} · Collection: ${esc(d.collection)}</p>`);return}showModal(s.name,`<span class="tag">${esc(s.type)}</span><p class="soft">${esc(s.short)}</p><p class="footer-note">${esc(s.date)} / Initial index · Full text resides in the editorial archive or source manuscript.</p>`,'STORY / TRANSMISSION')}
$('#portalSwitch').addEventListener('click',()=>setMode('portal'));$('#shadowSwitch').addEventListener('click',()=>setMode('shadow'));$('#brandHome').addEventListener('click',e=>{e.preventDefault();setMode('portal')});$('#modalClose').addEventListener('click',closeModal);$('#modalBackdrop').addEventListener('click',e=>{if(e.target.id==='modalBackdrop')closeModal()});document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.filter){category=b.dataset.filter;renderPortal()}else if(b.dataset.collection)openCollection(b.dataset.collection);else if(b.dataset.story)openStory(b.dataset.story);else if(b.dataset.crew){selectedCrew=Number(b.dataset.crew);renderCrew()}else if(b.dataset.admincrew!==undefined){selectedCrew=Number(b.dataset.admincrew);setMode('portal');document.getElementById('crew').scrollIntoView({behavior:'smooth'})}else if(b.dataset.admin){section=b.dataset.admin;renderAdmin()}else if(b.dataset.go){section=b.dataset.go;renderAdmin()}else if(b.dataset.new){draftModal()}else if(b.dataset.edit){draftModal(b.dataset.edit)}else if(b.id==='saveDraft'){submitDraft(false)}else if(b.id==='modalToShadow'){closeModal();setMode('shadow');section='studio';renderAdmin()}});document.addEventListener('submit',e=>{if(e.target.id==='draftForm'){e.preventDefault();submitDraft(true)}});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();const g=e.target.closest?.('[data-crewnode]');if(g&&(e.key==='Enter'||e.key===' ')){e.preventDefault();selectedCrew=Number(g.dataset.crewnode);renderCrew()}});$('#svgCrew').addEventListener('click',e=>{const g=e.target.closest('[data-crewnode]');if(g){selectedCrew=Number(g.dataset.crewnode);renderCrew()}});renderPortal();if(location.hash==='#shadow'){setMode('shadow')}
</script>
</body></html>
