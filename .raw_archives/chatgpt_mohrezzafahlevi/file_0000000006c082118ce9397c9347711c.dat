#!/usr/bin/env node
// Node.js 18+; probes the FIRST streamed bytes, not just HTTP HEAD/200.
// Usage: node verify-radio-streams.mjs
// Creates ./radio-stream-health.json and ./radio-indonesia-live-only.json.
import { writeFile } from 'node:fs/promises';
import radioStations from './radio-indonesia-top50.mjs';

const TIMEOUT_MS = Math.max(3000, Number(process.env.RADIO_TIMEOUT_MS || 12000));
const CONCURRENCY = Math.max(1, Math.min(12, Number(process.env.RADIO_CONCURRENCY || 5)));
const USER_AGENT = 'RadioCatalogHealthCheck/1.0 (+stream GET audio validation)';

async function probe(station) {
  const started = Date.now();
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort('timeout'), TIMEOUT_MS);
  try {
    const response = await fetch(station.streamUrl, {
      method: 'GET',
      signal: controller.signal,
      redirect: 'follow',
      headers: { 'user-agent': USER_AGENT, 'icy-metadata': '0', 'accept': 'audio/*,application/vnd.apple.mpegurl,application/x-mpegurl,*/*;q=0.5' },
    });
    const contentType = (response.headers.get('content-type') || '').toLowerCase();
    if (!response.ok) {
      await response.body?.cancel().catch(() => {});
      return { ...station, alive: false, status: response.status, contentType, reason: `HTTP ${response.status}`, checkedAt: new Date().toISOString(), latencyMs: Date.now()-started };
    }
    if (!response.body) throw new Error('No response body');
    const reader = response.body.getReader();
    const { value, done } = await reader.read();
    await reader.cancel().catch(() => {});
    const bytes = value?.byteLength || 0;
    const rawHead = Buffer.from(value || []).subarray(0, 64).toString('utf8');
    const isPlaylist = /mpegurl|m3u8/.test(contentType) || /^#EXTM3U/.test(rawHead);
    const looksAudio = /^audio\//.test(contentType) || /application\/(ogg|octet-stream)/.test(contentType)
      || /^ID3/.test(rawHead) || (bytes > 2 && value[0] === 0xff && (value[1] & 0xe0) === 0xe0)
      || /^OggS/.test(rawHead) || /^fLaC/.test(rawHead);
    // HLS manifest does not prove the first media segment decodes; labelled separately.
    const alive = !done && bytes > 0 && (looksAudio || isPlaylist);
    return { ...station, alive, status: response.status, contentType, bytes, reason: alive ? (isPlaylist ? 'HLS manifest returned' : 'audio bytes received') : 'No audio or HLS bytes', checkedAt: new Date().toISOString(), latencyMs: Date.now()-started };
  } catch (e) {
    return { ...station, alive: false, status: null, reason: String(e?.message || e).slice(0, 180), checkedAt: new Date().toISOString(), latencyMs: Date.now()-started };
  } finally {
    clearTimeout(timer);
    controller.abort();
  }
}

const results = Array(radioStations.length);
let next = 0;
await Promise.all(Array.from({ length: Math.min(CONCURRENCY, results.length) }, async () => {
  while (next < results.length) {
    const i = next++;
    results[i] = await probe(radioStations[i]);
    const s = results[i];
    console.log(`${String(i + 1).padStart(2)} ${s.alive ? 'LIVE ' : 'CHECK'} ${s.name} (${s.reason})`);
  }
}));

const live = results.filter((r) => r.alive);
await writeFile('radio-stream-health.json', JSON.stringify({ checkedAt: new Date().toISOString(), total: results.length, live: live.length, uncertainOrDown: results.length - live.length, results }, null, 2) + '\n');
await writeFile('radio-indonesia-live-only.json', JSON.stringify(live.map(({ name, streamUrl, genre, countryRef }) => ({ name, streamUrl, genre, countryRef, active: true })), null, 2) + '\n');
console.log(`\n${live.length}/${radioStations.length} stream responded with audio/HLS. Files saved.`);
// Exit 0: produced results successfully; per-station errors are recorded, not silently dropped.
