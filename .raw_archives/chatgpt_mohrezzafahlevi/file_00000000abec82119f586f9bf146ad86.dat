{
  "schema_version": "1.0.0",
  "document_type": "codex_one_shot_execution_spec",
  "name": "mw-edge-full-business-domain-build",
  "status": "implementation_ready",
  "repository": {
    "provider": "gitlab",
    "project": "bjo163/mw",
    "default_branch": "master",
    "source_of_truth": "live_repository_state",
    "workspace_type": "hybrid_rust_pnpm_monorepo"
  },
  "agent": {
    "name": "codex",
    "mode": "autonomous",
    "execution": "one_shot",
    "interaction": "non_interactive",
    "planning_only": false,
    "must_implement": true,
    "must_test": true,
    "must_autofix": true,
    "must_document": true,
    "stop_only_on": [
      "V0.1_READY",
      "VERIFIED_HARD_EXTERNAL_BLOCKER"
    ]
  },
  "target": {
    "path": "apps/mw-edge",
    "create_if_missing": true,
    "language": "javascript",
    "module_system": "esm",
    "runtime": "node_22",
    "package_manager": "pnpm_11_17_0",
    "http_adapter": "hono",
    "primary_database": "sqlite",
    "future_database": "d1",
    "architecture_role": "moonwitness_business_application_data_engine"
  },
  "mission": {
    "summary": "Build MW Edge as the canonical relational engine for MoonWitness-owned mutable business records using MW-native domain models, not Odoo models.",
    "execution_loop": [
      "AUDIT_LIVE_REPO",
      "VERIFY_BASELINE",
      "CREATE_OR_CONTINUE_APPS_MW_EDGE",
      "IMPLEMENT_ALL_MODEL_CATALOG_ENTRIES",
      "IMPLEMENT_ORM",
      "IMPLEMENT_SQLITE",
      "IMPLEMENT_MIGRATIONS",
      "IMPLEMENT_DOMAIN_SERVICES",
      "IMPLEMENT_INTERNAL_HTTP_ADAPTER",
      "TEST",
      "FIX",
      "RETEST",
      "DOCUMENT",
      "COMMIT",
      "FULL_VERIFY"
    ],
    "forbidden_early_stops": [
      "analysis_only",
      "audit_only",
      "plan_only",
      "todo_only",
      "architecture_only",
      "partial_implementation_without_verification"
    ]
  },
  "read_before_editing": [
    "AGENTS.md",
    "README.md",
    "package.json",
    "pnpm-workspace.yaml",
    "Cargo.toml",
    "config/services.json",
    "config/runtime-matrix.json",
    "config/ports.json",
    ".gitlab-ci.yml",
    ".gitignore",
    "crates/mw-api/**",
    "crates/mw-cockpit/**",
    "crates/mw-storage/**",
    "crates/mw-identity/**",
    "crates/mw-security/**",
    "crates/mw-runtime/**",
    "crates/mw-compute/**",
    "crates/mw-sync/**",
    "crates/mw-transport/**",
    "crates/mw-cloudflare-adapter/**",
    "apps/webhook/**",
    "docs/design/cockpit-information-architecture-blueprint.json",
    "specs/interface-and-api-boundary.json",
    "specs/repository-and-storage.json",
    "specs/replication-and-synchronization.json",
    "specs/0000000000112-infra-provider-connector-contract.json",
    "specs/0000000000113-tenant-isolation-authorization-boundary.json",
    "specs/0000000000114-saas-catalog-subscription-billing-contract.json",
    "specs/0000000000115-unified-audit-activity-provenance.json",
    "specs/0000000000116-support-ticket-incident-boundary.json",
    "specs/implement-cockpit-embedded-sqlite-projection-engine-and-realtime-telemetry.json",
    "specs/establish-api-and-cockpit-ownership.json",
    "decisions/0000000000122-establish-api-and-cockpit-ownership.json"
  ],
  "architecture_invariants": {
    "business_domain_first": true,
    "odoo_domain_clone_forbidden": true,
    "odoo_model_names_forbidden": [
      "res.partner",
      "res.company",
      "sale.order",
      "account.move",
      "product.template"
    ],
    "browser_single_origin": "mw-cockpit",
    "cockpit_generic_model_proxy_forbidden": true,
    "mw_edge_permanent_service_registration_in_v0_1": false,
    "no_model_without_ownership": true,
    "no_external_reference_as_local_fk_without_explicit_ownership": true,
    "semantic_distinctions": [
      "Identity != Permission",
      "Identity != Membership",
      "Authentication != Authorization",
      "Authorization != Trust",
      "Authorization != Execution",
      "Role != Entitlement",
      "Entitlement != Authorization",
      "Capability != Authorization",
      "Request != Authorization",
      "Request != Execution",
      "Action != Event",
      "Event != State",
      "State != Event",
      "Evidence != Truth",
      "Result != Provenance",
      "Availability != Authority",
      "Replication != Synchronization",
      "Offer != Allocation",
      "Order != Subscription",
      "Payment != Entitlement",
      "Support Ticket != Incident",
      "Incident != Radicle Issue",
      "Radicle Issue != Agent Task",
      "Patch != Release"
    ]
  },
  "existing_owner_boundaries": {
    "tasks": {
      "owner": "mw-task + tasks/*.json",
      "authority": "CANONICAL",
      "mw_edge_role": "NONE"
    },
    "cockpit_task_sqlite": {
      "owner": "mw-cockpit",
      "authority": "PROJECTION",
      "mw_edge_role": "NONE"
    },
    "git_radicle_forge": {
      "owner": "Git/Radicle/COB",
      "authority": "CANONICAL",
      "mw_edge_role": "NONE"
    },
    "identity": {
      "owner": "mw-identity",
      "authority": "CANONICAL_CONTRACT_OWNER",
      "mw_edge_role": "REFERENCE_ONLY"
    },
    "authorization": {
      "owner": "mw-security/policy boundary",
      "authority": "CANONICAL_POLICY_DECISION",
      "mw_edge_role": "REFERENCE_ONLY"
    },
    "runtime": {
      "owner": "mw-runtime",
      "authority": "CANONICAL_DOMAIN_OWNER",
      "mw_edge_role": "REFERENCE_ONLY"
    },
    "compute": {
      "owner": "mw-compute",
      "authority": "CANONICAL_DOMAIN_OWNER",
      "mw_edge_role": "REFERENCE_ONLY"
    },
    "content_and_provenance_storage": {
      "owner": "mw-storage",
      "authority": "CANONICAL_STORAGE_BOUNDARY",
      "mw_edge_role": "REFERENCE_ONLY"
    },
    "cloudflare_resource_control": {
      "owner": "mw-cloudflare-adapter",
      "authority": "OBSERVATION_AND_CONTROL_ADAPTER",
      "mw_edge_role": "NONE"
    },
    "webhook_ingress": {
      "owner": "apps/webhook",
      "authority": "INGRESS_APPLICATION",
      "mw_edge_role": "NONE"
    },
    "operator_gateway": {
      "owner": "mw-cockpit",
      "authority": "LOCAL_OPERATOR_HTTP_GATEWAY",
      "mw_edge_role": "INTERNAL_PROVIDER_ONLY_AFTER_SEPARATE_ADR"
    }
  },
  "authority_classes": {
    "CANONICAL": "Authoritative mutable state for the defined business scope.",
    "PROJECTION": "Rebuildable derived representation of another canonical source.",
    "CACHE": "Disposable retained copy for latency or availability.",
    "OBSERVATION": "Externally observed state with freshness/provenance and no automatic truth or authority claim."
  },
  "field_system": {
    "public_primitives": [
      "String",
      "Text",
      "Integer",
      "Decimal",
      "Boolean",
      "DateTime",
      "Enum",
      "Json",
      "Reference",
      "Relation"
    ],
    "system_fields": [
      {
        "name": "id",
        "type": "Integer",
        "managed": true,
        "cross_boundary_identity": false
      },
      {
        "name": "created_at",
        "type": "DateTime",
        "managed": true
      },
      {
        "name": "updated_at",
        "type": "DateTime",
        "managed": true
      }
    ],
    "reference_semantics": {
      "meaning": "Opaque stable identifier owned by another bounded context.",
      "must_not_auto_join": true,
      "must_not_auto_load": true,
      "must_not_imply_authorization": true,
      "must_not_create_local_fk": true
    },
    "relation_semantics": {
      "meaning": "Explicit relationship between MW Edge-owned canonical models.",
      "may_create_local_fk": true,
      "must_validate_target": true,
      "must_fail_closed_on_missing_required_target": true
    }
  },
  "model_catalog": [
    {
      "name": "business.organization",
      "table": "business_organizations",
      "domain": "business",
      "authority": "CANONICAL",
      "contract_status": "provisional",
      "must_create": true,
      "purpose": "Commercial organization record without replacing identity, membership, tenant authorization, or trust.",
      "fields": {
        "organization_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "ref_kind": "tenant_scope"
        },
        "name": {
          "type": "String",
          "required": true
        },
        "organization_type": {
          "type": "Enum",
          "required": true,
          "enum": [
            "internal",
            "customer",
            "vendor",
            "reseller",
            "other"
          ]
        },
        "lifecycle": {
          "type": "Enum",
          "required": true,
          "enum": [
            "draft",
            "active",
            "suspended",
            "archived"
          ],
          "default": "draft"
        },
        "owner_ref": {
          "type": "Reference",
          "ref_kind": "identity_or_organization_owner"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "organization is not identity",
        "organization is not membership",
        "organization lifecycle is not authorization"
      ]
    },
    {
      "name": "business.project",
      "table": "business_projects",
      "domain": "business",
      "authority": "CANONICAL",
      "contract_status": "provisional",
      "must_create": true,
      "purpose": "Business or delivery initiative linking related records without owning their lifecycles.",
      "fields": {
        "project_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "name": {
          "type": "String",
          "required": true
        },
        "description": {
          "type": "Text"
        },
        "status": {
          "type": "Enum",
          "required": true,
          "enum": [
            "planned",
            "active",
            "paused",
            "completed",
            "cancelled"
          ],
          "default": "planned"
        },
        "owner_ref": {
          "type": "Reference",
          "ref_kind": "identity_or_team"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "project may link records but does not own task, ticket, incident, order, issue, or provisioning lifecycle"
      ]
    },
    {
      "name": "crm.contact",
      "table": "crm_contacts",
      "domain": "crm",
      "authority": "CANONICAL",
      "contract_status": "provisional",
      "must_create": true,
      "purpose": "Business contact profile without becoming canonical authentication identity.",
      "fields": {
        "contact_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "organization_ref": {
          "type": "Relation",
          "target": "business.organization.organization_ref"
        },
        "identity_ref": {
          "type": "Reference",
          "ref_kind": "mw_identity"
        },
        "display_name": {
          "type": "String",
          "required": true
        },
        "email": {
          "type": "String"
        },
        "phone": {
          "type": "String"
        },
        "lifecycle": {
          "type": "Enum",
          "required": true,
          "enum": [
            "active",
            "inactive",
            "archived"
          ],
          "default": "active"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "contact is not identity",
        "email or phone does not prove authentication"
      ]
    },
    {
      "name": "crm.lead",
      "table": "crm_leads",
      "domain": "crm",
      "authority": "CANONICAL",
      "contract_status": "provisional",
      "must_create": true,
      "purpose": "Potential commercial lead.",
      "fields": {
        "lead_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "contact_ref": {
          "type": "Relation",
          "target": "crm.contact.contact_ref"
        },
        "organization_ref": {
          "type": "Relation",
          "target": "business.organization.organization_ref"
        },
        "title": {
          "type": "String",
          "required": true
        },
        "source_ref": {
          "type": "Reference",
          "ref_kind": "external_source"
        },
        "status": {
          "type": "Enum",
          "required": true,
          "enum": [
            "new",
            "qualified",
            "disqualified",
            "converted"
          ],
          "default": "new"
        },
        "owner_ref": {
          "type": "Reference",
          "ref_kind": "identity_or_team"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "lead is not opportunity",
        "qualified lead does not imply accepted order"
      ]
    },
    {
      "name": "crm.opportunity",
      "table": "crm_opportunities",
      "domain": "crm",
      "authority": "CANONICAL",
      "contract_status": "provisional",
      "must_create": true,
      "purpose": "Qualified commercial opportunity.",
      "fields": {
        "opportunity_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "lead_ref": {
          "type": "Relation",
          "target": "crm.lead.lead_ref"
        },
        "contact_ref": {
          "type": "Relation",
          "target": "crm.contact.contact_ref"
        },
        "organization_ref": {
          "type": "Relation",
          "target": "business.organization.organization_ref"
        },
        "title": {
          "type": "String",
          "required": true
        },
        "stage": {
          "type": "Enum",
          "required": true,
          "enum": [
            "open",
            "proposal",
            "negotiation",
            "won",
            "lost"
          ],
          "default": "open"
        },
        "owner_ref": {
          "type": "Reference",
          "ref_kind": "identity_or_team"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "opportunity is not order",
        "opportunity won does not imply order accepted"
      ]
    },
    {
      "name": "reseller.relationship",
      "table": "reseller_relationships",
      "domain": "reseller",
      "authority": "CANONICAL",
      "contract_status": "provisional",
      "must_create": true,
      "purpose": "Commercial relationship between a reseller organization and downstream tenant scope.",
      "fields": {
        "relationship_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "platform_or_owner_tenant"
        },
        "reseller_organization_ref": {
          "type": "Relation",
          "required": true,
          "target": "business.organization.organization_ref"
        },
        "downstream_tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "status": {
          "type": "Enum",
          "required": true,
          "enum": [
            "pending",
            "active",
            "suspended",
            "terminated"
          ],
          "default": "pending"
        },
        "authorization_ref": {
          "type": "Reference",
          "ref_kind": "authorization_decision"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "relationship does not create identity membership",
        "relationship does not imply authorization"
      ]
    },
    {
      "name": "reseller.commission",
      "table": "reseller_commissions",
      "domain": "reseller",
      "authority": "CANONICAL",
      "contract_status": "provisional",
      "must_create": true,
      "purpose": "Commercial commission record linked to reseller and business source.",
      "fields": {
        "commission_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "reseller_organization_ref": {
          "type": "Relation",
          "required": true,
          "target": "business.organization.organization_ref"
        },
        "source_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "order_subscription_or_invoice"
        },
        "amount": {
          "type": "Decimal",
          "required": true
        },
        "currency": {
          "type": "String",
          "required": true
        },
        "status": {
          "type": "Enum",
          "required": true,
          "enum": [
            "pending",
            "earned",
            "approved",
            "paid",
            "void"
          ],
          "default": "pending"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "commission paid is not payment-provider observation"
      ]
    },
    {
      "name": "catalog.product",
      "table": "catalog_products",
      "domain": "catalog",
      "authority": "CANONICAL",
      "contract_status": "approved",
      "must_create": true,
      "purpose": "Defines a sellable product or service.",
      "fields": {
        "product_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "owner_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "identity_or_organization_owner"
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "name": {
          "type": "String",
          "required": true
        },
        "description": {
          "type": "Text"
        },
        "product_kind": {
          "type": "Enum",
          "required": true,
          "enum": [
            "service",
            "digital",
            "physical",
            "bundle",
            "other"
          ]
        },
        "lifecycle": {
          "type": "Enum",
          "required": true,
          "enum": [
            "draft",
            "active",
            "suspended",
            "retired"
          ],
          "default": "draft"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "product is not offer",
        "product does not imply entitlement"
      ]
    },
    {
      "name": "catalog.offer",
      "table": "catalog_offers",
      "domain": "catalog",
      "authority": "CANONICAL",
      "contract_status": "approved",
      "must_create": true,
      "purpose": "Prices and scopes a product for a commercial subject.",
      "fields": {
        "offer_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "product_ref": {
          "type": "Relation",
          "required": true,
          "target": "catalog.product.product_ref"
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "scope_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "commercial_scope"
        },
        "terms_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "terms"
        },
        "price_amount": {
          "type": "Decimal"
        },
        "price_currency": {
          "type": "String"
        },
        "lifecycle": {
          "type": "Enum",
          "required": true,
          "enum": [
            "draft",
            "active",
            "suspended",
            "retired"
          ],
          "default": "draft"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "offer is not allocation",
        "offer does not prove authorization"
      ]
    },
    {
      "name": "commerce.order",
      "table": "commerce_orders",
      "domain": "commerce",
      "authority": "CANONICAL",
      "contract_status": "approved",
      "must_create": true,
      "purpose": "Records customer intent to acquire an offer.",
      "fields": {
        "order_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "offer_ref": {
          "type": "Relation",
          "required": true,
          "target": "catalog.offer.offer_ref"
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "subject_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "customer_or_subject"
        },
        "authorization_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "authorization_decision"
        },
        "policy_version": {
          "type": "String",
          "required": true
        },
        "status": {
          "type": "Enum",
          "required": true,
          "enum": [
            "draft",
            "submitted",
            "accepted",
            "rejected",
            "cancelled"
          ],
          "default": "draft"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "order is not subscription",
        "accepted order must not silently create subscription",
        "request is not authorization"
      ]
    },
    {
      "name": "service.subscription",
      "table": "service_subscriptions",
      "domain": "service",
      "authority": "CANONICAL",
      "contract_status": "approved",
      "must_create": true,
      "purpose": "Accepted recurring or finite service relationship.",
      "fields": {
        "subscription_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "order_ref": {
          "type": "Relation",
          "required": true,
          "target": "commerce.order.order_ref"
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "lifecycle": {
          "type": "Enum",
          "required": true,
          "enum": [
            "pending",
            "active",
            "suspended",
            "cancelled",
            "expired"
          ],
          "default": "pending"
        },
        "effective_at": {
          "type": "DateTime",
          "required": true
        },
        "expires_at": {
          "type": "DateTime"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "subscription active does not prove provisioning",
        "subscription is not allocation",
