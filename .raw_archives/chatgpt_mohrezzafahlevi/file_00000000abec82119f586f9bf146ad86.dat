          "target": "service.subscription.subscription_ref"
        },
        "status": {
          "type": "Enum",
          "required": true,
          "enum": [
            "pending",
            "active",
            "suspended",
            "terminated"
          ],
          "default": "pending"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "subscriber is not identity",
        "subscriber is not radius credential",
        "commercial subscription and access session remain distinct"
      ]
    },
    {
      "name": "isp.nas",
      "table": "isp_nas",
      "domain": "isp",
      "authority": "CANONICAL",
      "contract_status": "provisional_business_os",
      "must_create": true,
      "purpose": "Network access server inventory/configuration reference.",
      "fields": {
        "nas_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "name": {
          "type": "String",
          "required": true
        },
        "host_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "network_host"
        },
        "vendor": {
          "type": "String"
        },
        "status": {
          "type": "Enum",
          "required": true,
          "enum": [
            "planned",
            "active",
            "degraded",
            "retired"
          ],
          "default": "planned"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      }
    },
    {
      "name": "isp.ip_pool",
      "table": "isp_ip_pools",
      "domain": "isp",
      "authority": "CANONICAL",
      "contract_status": "provisional_business_os",
      "must_create": true,
      "purpose": "IP pool definition for subscriber access allocation.",
      "fields": {
        "ip_pool_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "name": {
          "type": "String",
          "required": true
        },
        "cidr": {
          "type": "String",
          "required": true
        },
        "family": {
          "type": "Enum",
          "required": true,
          "enum": [
            "ipv4",
            "ipv6"
          ]
        },
        "status": {
          "type": "Enum",
          "required": true,
          "enum": [
            "active",
            "inactive",
            "retired"
          ],
          "default": "active"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      }
    },
    {
      "name": "isp.bandwidth_profile",
      "table": "isp_bandwidth_profiles",
      "domain": "isp",
      "authority": "CANONICAL",
      "contract_status": "provisional_business_os",
      "must_create": true,
      "purpose": "Subscriber bandwidth/service profile definition.",
      "fields": {
        "bandwidth_profile_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "name": {
          "type": "String",
          "required": true
        },
        "download_bps": {
          "type": "Integer",
          "required": true
        },
        "upload_bps": {
          "type": "Integer",
          "required": true
        },
        "status": {
          "type": "Enum",
          "required": true,
          "enum": [
            "active",
            "inactive",
            "retired"
          ],
          "default": "active"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      }
    },
    {
      "name": "isp.radius_profile",
      "table": "isp_radius_profiles",
      "domain": "isp",
      "authority": "CANONICAL",
      "contract_status": "provisional_business_os",
      "must_create": true,
      "purpose": "RADIUS policy/profile reference without plaintext secret storage.",
      "fields": {
        "radius_profile_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "name": {
          "type": "String",
          "required": true
        },
        "bandwidth_profile_ref": {
          "type": "Relation",
          "target": "isp.bandwidth_profile.bandwidth_profile_ref"
        },
        "ip_pool_ref": {
          "type": "Relation",
          "target": "isp.ip_pool.ip_pool_ref"
        },
        "attributes": {
          "type": "Json"
        },
        "status": {
          "type": "Enum",
          "required": true,
          "enum": [
            "active",
            "inactive",
            "retired"
          ],
          "default": "active"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "forbidden_fields": [
        "password",
        "shared_secret",
        "private_key",
        "token"
      ]
    },
    {
      "name": "isp.pppoe_account",
      "table": "isp_pppoe_accounts",
      "domain": "isp",
      "authority": "CANONICAL",
      "contract_status": "provisional_business_os",
      "must_create": true,
      "purpose": "PPPoE access account metadata referencing secret material indirectly.",
      "fields": {
        "pppoe_account_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "subscriber_ref": {
          "type": "Relation",
          "required": true,
          "target": "isp.subscriber.subscriber_ref"
        },
        "username": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "credential_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "secret_or_identity_credential"
        },
        "radius_profile_ref": {
          "type": "Relation",
          "target": "isp.radius_profile.radius_profile_ref"
        },
        "nas_ref": {
          "type": "Relation",
          "target": "isp.nas.nas_ref"
        },
        "status": {
          "type": "Enum",
          "required": true,
          "enum": [
            "pending",
            "active",
            "suspended",
            "revoked"
          ],
          "default": "pending"
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "credential reference is not plaintext secret",
        "PPPoE account is not subscriber identity"
      ],
      "forbidden_fields": [
        "password",
        "chap_secret",
        "mschap_secret",
        "shared_secret"
      ]
    },
    {
      "name": "isp.pppoe_session",
      "table": "isp_pppoe_sessions",
      "domain": "isp",
      "authority": "OBSERVATION",
      "contract_status": "provisional_business_os",
      "must_create": true,
      "purpose": "Observed PPPoE access session state.",
      "fields": {
        "session_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "subscriber_ref": {
          "type": "Relation",
          "required": true,
          "target": "isp.subscriber.subscriber_ref"
        },
        "pppoe_account_ref": {
          "type": "Relation",
          "required": true,
          "target": "isp.pppoe_account.pppoe_account_ref"
        },
        "nas_ref": {
          "type": "Relation",
          "target": "isp.nas.nas_ref"
        },
        "framed_ip": {
          "type": "String"
        },
        "status": {
          "type": "Enum",
          "required": true,
          "enum": [
            "starting",
            "active",
            "stopped",
            "failed"
          ]
        },
        "started_at": {
          "type": "DateTime"
        },
        "stopped_at": {
          "type": "DateTime"
        },
        "observed_at": {
          "type": "DateTime",
          "required": true
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "session is observation",
        "session is not subscriber identity",
        "session active does not prove entitlement"
      ]
    },
    {
      "name": "isp.usage_record",
      "table": "isp_usage_records",
      "domain": "isp",
      "authority": "OBSERVATION",
      "contract_status": "provisional_business_os",
      "must_create": true,
      "purpose": "Observed subscriber/session usage record.",
      "fields": {
        "usage_ref": {
          "type": "String",
          "required": true,
          "unique": true
        },
        "tenant_ref": {
          "type": "Reference",
          "required": true,
          "ref_kind": "tenant_scope"
        },
        "subscriber_ref": {
          "type": "Relation",
          "required": true,
          "target": "isp.subscriber.subscriber_ref"
        },
        "session_ref": {
          "type": "Relation",
          "target": "isp.pppoe_session.session_ref"
        },
        "nas_ref": {
          "type": "Relation",
          "target": "isp.nas.nas_ref"
        },
        "bytes_in": {
          "type": "Integer",
          "required": true
        },
        "bytes_out": {
          "type": "Integer",
          "required": true
        },
        "started_at": {
          "type": "DateTime"
        },
        "ended_at": {
          "type": "DateTime"
        },
        "observed_at": {
          "type": "DateTime",
          "required": true
        },
        "provenance_ref": {
          "type": "Reference",
          "ref_kind": "provenance"
        }
      },
      "semantic_guards": [
        "usage is observation",
        "usage does not prove billing amount"
      ]
    }
  ],
  "model_catalog_validation": {
    "expected_model_count": 36,
    "all_entries_must_have": [
      "name",
      "table",
      "domain",
      "authority",
      "contract_status",
      "must_create",
      "purpose",
      "fields"
    ],
    "all_models_must_be_created": true,
    "all_tables_must_be_created": true,
    "all_models_must_have_tests": true,
    "provisional_semantics_rule": "Create the model and tests, but do not claim stronger lifecycle or authority semantics than this specification defines."
  },
  "domain_services": {
    "required": true,
    "rule": "Business lifecycle and cross-record operations live above the generic ORM.",
    "commands": {
      "business": [
        "createOrganization",
        "activateOrganization",
        "suspendOrganization",
        "archiveOrganization",
        "createProject",
        "activateProject",
        "pauseProject",
        "completeProject",
        "cancelProject"
      ],
      "crm": [
        "createContact",
        "createLead",
        "qualifyLead",
        "disqualifyLead",
        "convertLeadToOpportunity",
        "advanceOpportunity",
        "closeOpportunityWon",
        "closeOpportunityLost"
      ],
      "reseller": [
        "createRelationship",
        "activateRelationship",
        "suspendRelationship",
        "terminateRelationship",
        "recordCommission",
        "approveCommission",
        "markCommissionPaid"
      ],
      "catalog": [
        "createProduct",
        "activateProduct",
        "retireProduct",
        "createOffer",
        "activateOffer",
        "retireOffer"
      ],
      "commerce": [
        "createOrder",
        "submitOrder",
        "acceptOrder",
        "rejectOrder",
        "cancelOrder"
      ],
      "service": [
        "createSubscription",
        "activateSubscription",
        "suspendSubscription",
        "cancelSubscription",
        "expireSubscription"
      ],
      "billing": [
        "createInvoice",
        "issueInvoice",
        "markInvoicePaid",
        "voidInvoice",
        "markInvoiceOverdue",
        "recordPaymentObservation",
        "recordRefundObservation"
      ],
      "entitlement": [
        "createAllocation",
        "activateAllocation",
        "suspendAllocation",
        "revokeAllocation"
      ],
      "provisioning": [
        "createProvisioningReference",
        "updateProvisioningReferenceFromExternalResult"
      ],
      "support": [
        "createTicket",
        "triageTicket",
        "resolveTicket",
        "closeTicket",
        "escalateTicket"
      ],
      "knowledge": [
        "createArticle",
        "publishArticle",
        "archiveArticle"
      ],
      "procurement": [
        "createVendor",
        "createPurchaseOrder",
        "submitPurchaseOrder",
        "approvePurchaseOrder",
        "rejectPurchaseOrder",
        "cancelPurchaseOrder"
      ],
      "inventory": [
        "createItem",
        "createLocation",
        "recordStockMovement"
      ],
      "finance": [
        "createAccount",
        "createJournalEntry",
        "addJournalLine",
        "postJournalEntry",
        "reverseJournalEntry"
      ],
      "isp": [
        "createSubscriber",
        "activateSubscriber",
        "suspendSubscriber",
        "terminateSubscriber",
        "createNas",
        "createIpPool",
        "createBandwidthProfile",
        "createRadiusProfile",
        "createPppoeAccount",
        "recordPppoeSessionObservation",
        "recordUsageObservation"
      ]
    },
    "forbidden_implicit_transitions": [
      "payment_succeeded_to_allocation",
      "payment_succeeded_to_subscription_activation",
      "accepted_order_to_subscription_creation",
      "subscription_active_to_provisioning_success",
      "allocation_to_provider_execution",
      "support_ticket_to_incident_conversion",
      "support_ticket_to_radicle_issue_conversion",
      "pppoe_account_to_identity"
    ]
  },
  "orm_contract": {
    "principle": "MW-native, domain-serving, backend-neutral, not Odoo-compatible by default.",
    "required_capabilities": [
      "model_registry",
      "create",
      "create_many",
      "get_by_ref",
      "find",
      "find_one",
      "count",
      "update",
      "delete",
      "transactions",
      "enum_validation",
      "reference_validation",
      "relation_validation",
      "ordering",
      "pagination",
      "filtering",
      "parameterized_sql"
    ],
    "query_operators": [
      "eq",
      "ne",
      "gt",
      "gte",
      "lt",
      "lte",
      "like",
      "ilike",
      "in",
      "notIn",
      "isNull",
      "notNull",
      "and",
      "or",
      "not"
    ],
    "forbidden_requirements": [
      "Odoo browse compatibility",
      "Odoo searchRead compatibility",
      "RecordSet parity",
      "Many2one naming",
      "Odoo tuple-domain syntax as canonical public API"
    ],
    "backend_invariant": "Changing SQLite to D1 must not change model or domain semantics."
  },
  "database_contract": {
    "directory": "apps/mw-edge/src/database",
    "adapter_capabilities": [
      "execute",
      "query",
      "first",
      "transaction",
      "migrate",
      "close"
    ],
    "sqlite": {
      "required": true,
      "modes": [
        ":memory:",
        "file"
      ],
      "foreign_keys": true,
      "pragma": "PRAGMA foreign_keys = ON;",
      "prepared_statements": true
    },
    "d1": {
      "required_for_v0_1": false,
      "must_have_adapter_boundary": true,
      "must_not_require_cloudflare_credentials_for_default_tests": true
    }
  },
  "migration_contract": {
    "directory": "apps/mw-edge/migrations",
    "tracking_table": "mw_migrations",
    "tracking_columns": [
      "id",
      "name",
      "checksum",
      "applied_at"
    ],
    "requirements": [
      "deterministic_discovery",
      "deterministic_order",
      "checksum",
      "atomic_per_migration",
      "idempotent_rerun",
      "historical_checksum_mismatch_fail_closed",
      "rollback_on_failure"
    ],
    "must_create_all_model_tables": true
  },
  "http_adapter": {
    "framework": "hono",
    "role": "development_and_internal_adapter_only",
    "permanent_runtime_registration_v0_1": false,
    "generic_model_api_browser_exposure": false,
    "cockpit_rule": "Browser continues to call only mw-cockpit. Do not create direct browser-to-mw-edge dependency."
  },
  "security_rules": {
    "forbidden_secret_fields_global": [
      "password",
      "private_key",
      "token",
      "bearer",
      "session_secret",
      "payment_secret",
      "card_number",
      "cvv",
      "bank_secret",
      "payment_token",
      "shared_secret",
      "chap_secret",
      "mschap_secret"
    ],
    "tenant_ref_is_not_authorization": true,
    "role_is_not_authorization": true,
    "ui_visibility_is_not_isolation": true,
    "authorization_ref_is_reference_to_decision": true,
    "mw_edge_must_not_implement_competing_identity_system": true,
    "mw_edge_must_not_implement_competing_policy_engine_v0_1": true
  },
  "non_overlap_rules": [
    "Do not move or duplicate mw-cockpit TaskCache into MW Edge.",
    "Do not create canonical task, Git, Radicle issue, patch, review, commit, or repository models in MW Edge.",
    "Do not convert crates/mw-storage into relational persistence.",
    "Do not turn crates/mw-api into an HTTP service.",
    "Do not modify crates/mw-cloudflare-adapter for D1 relational access.",
    "Do not absorb apps/webhook.",
    "Do not create canonical identity, membership, role, or authorization-decision tables unless a later accepted architecture assigns ownership.",
    "Do not register MW Edge in config/services.json, config/runtime-matrix.json, or config/ports.json during v0.1 without a new accepted service-boundary ADR."
  ],
  "test_contract": {
    "must_use_real_models": true,
    "fake_demo_models_do_not_satisfy_release_gate": true,
    "required_test_groups": [
      "model_registry",
      "all_model_schema_creation",
      "all_required_fields",
      "all_enum_validation",
      "all_local_relation_fk_validation",
      "all_external_reference_opaque_behavior",
      "crud_for_each_model",
      "query_for_each_domain",
      "ordering",
      "pagination",
      "transaction_commit",
      "transaction_rollback",
      "migration_fresh",
      "migration_rerun",
      "migration_checksum_mismatch",
      "sql_injection",
      "forbidden_secret_field_rejection",
      "domain_negative_semantics",
      "http_adapter_smoke",
      "safe_error_contract"
    ],
    "mandatory_negative_semantic_tests": [
      "accepted order does not silently create subscription",
      "payment succeeded does not silently activate subscription",
      "payment succeeded does not silently create allocation",
      "allocation without authorization_ref is rejected",
      "provisioning reference does not execute provider operation",
      "support ticket does not become incident by status change",
      "support ticket does not become Radicle issue",
      "tenant_ref does not imply authorization",
      "external Reference does not auto-dereference",
      "PPPoE credential secret cannot be persisted",
      "payment secret fields cannot be persisted",
      "journal entry cannot be posted if debit and credit totals are unbalanced"
    ]
  },
  "implementation_order": [
    "P0_AUDIT_REPOSITORY_AND_GOVERNANCE",
    "P1_CREATE_APPS_MW_EDGE_PACKAGE",
    "P2_IMPLEMENT_FIELD_REFERENCE_RELATION_SEMANTICS",
    "P3_IMPLEMENT_DATABASE_ADAPTER_CONTRACT",
    "P4_IMPLEMENT_SQLITE_ADAPTER",
    "P5_IMPLEMENT_MIGRATION_ENGINE",
    "P6_IMPLEMENT_MODEL_REGISTRY",
    "P7_GENERATE_ALL_MODEL_CATALOG_SOURCE_FILES",
    "P8_GENERATE_ALL_MODEL_MIGRATIONS",
    "P9_IMPLEMENT_DOMAIN_SERVICES",
    "P10_IMPLEMENT_QUERY_LAYER",
    "P11_IMPLEMENT_TRANSACTIONS",
    "P12_IMPLEMENT_INTERNAL_HONO_ADAPTER",
    "P13_IMPLEMENT_TESTS_FOR_ALL_MODELS",
    "P14_RUN_AUTOFIX_LOOP_UNTIL_GREEN",
    "P15_ADD_FOCUSED_GITLAB_CI",
    "P16_WRITE_APPS_MW_EDGE_README",
    "P17_RUN_FULL_VERIFICATION",
    "P18_COMMIT_LOGICAL_BATCHES"
  ],
  "file_layout": {
    "root": "apps/mw-edge",
    "paths": [
      "src/domain/business",
      "src/domain/crm",
      "src/domain/reseller",
      "src/domain/catalog",
      "src/domain/commerce",
      "src/domain/service",
      "src/domain/billing",
      "src/domain/entitlement",
      "src/domain/provisioning",
      "src/domain/support",
      "src/domain/knowledge",
      "src/domain/procurement",
      "src/domain/inventory",
      "src/domain/finance",
      "src/domain/isp",
      "src/orm",
      "src/database",
      "src/http",
      "src/config",
      "migrations",
      "test/unit",
      "test/integration",
      "test/database",
      "data"
    ]
  },
  "ci_contract": {
    "cloudflare_credentials_required": false,
    "required_steps": [
      "pnpm install --frozen-lockfile",
      "mw-edge lint",
      "mw-edge format check",
      "mw-edge unit tests",
      "mw-edge sqlite integration tests",
      "mw-edge migration tests",
      "mw-edge domain semantic tests"
    ],
    "must_not_break_unrelated_jobs": true
  },
  "documentation_contract": {
    "required_file": "apps/mw-edge/README.md",
    "must_document": [
      "architecture role",
      "ownership matrix",
      "authority classes",
      "all model_catalog entries",
      "Reference vs Relation",
      "SQLite-first configuration",
      "migration commands",
      "test commands",
      "domain semantics",
      "forbidden overlaps",
      "Cockpit boundary",
      "future D1 path"
    ],
    "must_state": [
      "MW Edge does not own tasks, Git/Radicle records, identity, authorization, runtime, provenance storage, Cloudflare resource control, or webhook ingress.",
      "Browser must not call MW Edge directly.",
      "External references are opaque and are not automatically local foreign keys.",
      "All model_catalog models are created in v0.1; provisional models must not claim stronger semantics than this spec defines."
    ]
  },
  "git_policy": {
    "destructive_history_operations_forbidden": true,
    "force_push_forbidden": true,
    "logical_commits_required": true,
    "suggested_commits": [
      "feat(mw-edge): establish MW-native business engine foundation",
      "feat(mw-edge): add SQLite adapter and deterministic migrations",
      "feat(mw-edge): implement full business model catalog",
      "feat(mw-edge): add domain services and lifecycle guards",
      "feat(mw-edge): add internal Hono adapter",
      "test(mw-edge): add full-domain SQLite and semantic coverage",
      "ci(mw-edge): add provider-neutral validation",
      "docs(mw-edge): document ownership and full model catalog"
    ]
  },
  "release_gate": {
    "workspace": [
      "apps/mw-edge exists",
      "pnpm workspace recognizes app",
      "no new repository created",
      "no new Rust crate created"
    ],
    "models": [
      "business.organization",
      "business.project",
      "crm.contact",
      "crm.lead",
      "crm.opportunity",
      "reseller.relationship",
      "reseller.commission",
      "catalog.product",
      "catalog.offer",
      "commerce.order",
      "service.subscription",
      "billing.invoice",
      "billing.payment",
      "entitlement.allocation",
      "provisioning.reference",
      "support.sla",
      "support.ticket",
