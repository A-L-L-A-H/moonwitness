<!DOCTYPE html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>MoonWitness — Home Landing Concept</title><style>

:root{--ink:#141f27;--sub:#556570;--cream:#f5f3eb;--line:#d8dfdd;--orange:#e86140;--mint:#bce7c4;--teal:#215d58;--blue:#dcebf3;--yellow:#f3dd97;--white:#fff;--lilac:#e4dbf0}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font:15px 'DejaVu Sans',Arial,sans-serif}a{color:inherit;text-decoration:none}button,input{font:inherit}button{cursor:pointer}.mono{font-family:'DejaVu Sans Mono',monospace;letter-spacing:.045em}.display{font-family:'DejaVu Sans','DejaVu Sans',sans-serif;letter-spacing:-.047em}.smallcaps{font-size:10px;letter-spacing:.17em;text-transform:uppercase;font-weight:700}.muted{color:var(--sub)}.pill{border:1px solid #cbd4d2;border-radius:99px;padding:7px 11px;font-size:10px;letter-spacing:.08em;font-family:'DejaVu Sans Mono',monospace;display:inline-flex;align-items:center;gap:7px;white-space:nowrap}.dot{width:7px;height:7px;border-radius:50%;display:inline-block;background:#e9a04f}.dot.ok{background:#57b291}.dot.slate{background:#8a999c}.logo{display:flex;align-items:center;gap:12px;font-family:'DejaVu Sans';font-size:20px;font-weight:700;letter-spacing:-.06em}.logo-mark{position:relative;background:#17252e;border-radius:50%;height:36px;width:36px;display:inline-block;flex-shrink:0;overflow:hidden}.logo-mark:after{content:'';position:absolute;left:11px;top:-5px;background:#f5f3eb;height:32px;width:32px;border-radius:50%}.logo .label{display:block;font:9px 'DejaVu Sans Mono',monospace;letter-spacing:.16em;color:#65757e;margin-top:2px}.orange{color:var(--orange)}.topstripe{height:6px;background:linear-gradient(90deg,#17252e 0 32%,#e86140 32% 58%,#a7d1bd 58% 81%,#eac977 81%)}
/* home */
.home-shell{max-width:1600px;margin:auto;background:#faf9f4;min-height:100vh}.announcement{height:34px;background:#182730;color:#e1f2e8;display:flex;align-items:center;justify-content:space-between;padding:0 68px;font:10px 'DejaVu Sans Mono',monospace;letter-spacing:.1em}.announcement .star{color:#e9ae75}.home-header{height:82px;padding:0 68px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #dfe4e1;background:#fbfaf6}.menu{display:flex;align-items:center;gap:32px;font-size:12px;font-weight:700}.menu a{padding:8px 0}.menu a:first-child{border-bottom:2px solid var(--orange)}.header-actions{display:flex;align-items:center;gap:14px}.btn{border:0;background:var(--ink);color:#fff;padding:14px 22px;border-radius:7px;font-size:12px;font-weight:700;white-space:nowrap}.btn.alt{background:transparent;color:var(--ink);border:1px solid #acbab7}.btn.accent{background:var(--orange)}.hero{min-height:580px;padding:60px 68px 50px;display:grid;grid-template-columns:57% 43%;gap:8px;position:relative;overflow:hidden}.hero h1{font-family:'DejaVu Sans';letter-spacing:-.082em;font-size:83px;font-weight:600;line-height:.98;margin:23px 0 20px;max-width:790px}.hero h1 em{font-style:normal;color:var(--orange)}.hero-intro{font-size:16px;color:#54646d;line-height:1.75;max-width:570px;margin:0 0 28px}.eyebrow{display:flex;gap:10px;align-items:center;font:700 10px 'DejaVu Sans Mono';letter-spacing:.16em}.eyebrow .dash{width:30px;height:1px;background:var(--orange)}.searchbar{border:2px solid #24343e;background:#fff;max-width:635px;height:60px;border-radius:8px;display:flex;align-items:center;padding:7px 7px 7px 17px;box-shadow:6px 6px 0 #e8e2d3}.search-icon{font-size:25px;margin-right:12px;color:var(--orange)}.searchbar input{border:0;outline:0;width:100%;font-size:12px;color:var(--ink);min-width:0}.searchbar button{height:42px;border-radius:5px;border:0;background:var(--ink);color:#fff;padding:0 18px;font-size:12px;font-weight:700}.hints{display:flex;align-items:center;gap:9px;margin-top:18px;flex-wrap:wrap}.hints span:first-child{font-size:11px;color:#74828a}.hint{font:10px 'DejaVu Sans Mono';background:#efefe9;border:1px solid #e3e3d9;padding:7px 9px;border-radius:4px}.hero-bottom{display:flex;align-items:center;gap:25px;margin-top:46px}.stat-small{display:flex;gap:11px;align-items:center}.stat-small strong{font:700 26px 'DejaVu Sans';letter-spacing:-.05em}.stat-small span{max-width:95px;font:9px 'DejaVu Sans Mono';text-transform:uppercase;line-height:1.55;color:#677681;letter-spacing:.08em}.hero-visual{position:relative;min-height:488px;margin-top:3px}.orbit-card{position:absolute;inset:12px 15px 25px 22px;background:#17262e;border-radius:24px;overflow:hidden;border:1px solid #415159;box-shadow:12px 12px 0 #e7e6de}.orbit-card:before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 55% 41%,#2b494b,transparent 58%),radial-gradient(#ffffff1a .7px,transparent .7px);background-size:auto,15px 15px}.orbital{position:absolute;inset:20px;width:calc(100% - 40px);height:calc(100% - 40px)}.orbit-title{position:absolute;left:30px;top:24px;color:#b6cbcd;font:10px 'DejaVu Sans Mono';letter-spacing:.16em}.orbit-foot{position:absolute;left:30px;right:30px;bottom:26px;display:flex;justify-content:space-between;align-items:center;color:#9bb4b0;font:9px 'DejaVu Sans Mono';letter-spacing:.08em}.floating{position:absolute;z-index:3;background:#fff;border:1px solid #d7dbd5;border-radius:8px;box-shadow:0 8px 20px #09121722;padding:12px 16px}.floating.top{right:-3px;top:96px;width:158px}.floating.bottom{left:-19px;bottom:45px;width:205px}.floating .value{font-family:'DejaVu Sans';font-size:16px;font-weight:700;line-height:1.3;margin-top:5px}.section-label{font:700 10px 'DejaVu Sans Mono';letter-spacing:.19em;text-transform:uppercase;color:#66757c}.product-section{padding:33px 68px 43px;border-top:1px solid #dde2de;background:#f0f1e9}.section-head{display:flex;align-items:end;justify-content:space-between;gap:10px;margin-bottom:22px}.section-head h2{font:600 29px 'DejaVu Sans';letter-spacing:-.055em;margin:9px 0 0}.section-head p{font-size:12px;color:#63727b;max-width:420px;margin:0;line-height:1.6}.features{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.feature{background:#fff;border:1px solid #d8dfdb;border-radius:11px;padding:20px 18px 17px;min-height:160px;position:relative}.feature .symbol{font:600 32px 'DejaVu Sans';letter-spacing:-.08em;color:#c1c9c3}.feature h3{font:700 18px 'DejaVu Sans';margin:18px 0 7px;letter-spacing:-.035em}.feature p{font-size:11px;color:#6e7a80;line-height:1.55;margin:0;max-width:185px}.feature:nth-child(2){background:#e5f1eb}.feature:nth-child(4){background:#f3e9dd}.feature:nth-child(5){background:#e5eaf2}.feature .arrow{position:absolute;right:18px;top:21px;font-size:18px}.journey{padding:40px 68px;display:grid;grid-template-columns:40% 60%;gap:30px;align-items:center;background:#fbfaf6}.journey h2{font:600 31px 'DejaVu Sans';letter-spacing:-.055em;line-height:1.15;margin:12px 0}.journey p{color:#68777d;font-size:13px;line-height:1.7;max-width:470px}.step-chain{background:#fff;border:1px solid #dbe1dd;border-radius:10px;padding:26px 22px;display:flex;align-items:center;gap:14px;justify-content:space-between}.chain-step{text-align:center;font:10px 'DejaVu Sans Mono';text-transform:uppercase;letter-spacing:.07em}.chain-step b{display:block;border:1px solid #dde3df;padding:16px 12px;background:#f6f6f1;font:700 15px 'DejaVu Sans';border-radius:6px;letter-spacing:-.03em;margin-bottom:10px}.chain-arrow{color:var(--orange);font-size:23px}.fineprint{padding:15px 68px;border-top:1px solid #dbe0dc;display:flex;justify-content:space-between;color:#7a878d;font:9px 'DejaVu Sans Mono';letter-spacing:.09em}
/* admin */
.admin-app{display:flex;min-height:1050px;background:#f6f7f4;max-width:1600px;margin:auto}.sidebar{width:264px;background:#182831;color:#e9f0ec;flex-shrink:0;display:flex;flex-direction:column}.sidebar .brand{display:flex;align-items:center;gap:12px;padding:28px 21px 26px;border-bottom:1px solid #35444b}.sidebar .logo-mark{background:#e6f1e9;width:35px;height:35px}.sidebar .logo-mark:after{background:#182831}.sidebar .brand strong{font:700 18px 'DejaVu Sans';letter-spacing:-.05em}.sidebar .brand small{display:block;font:9px 'DejaVu Sans Mono';letter-spacing:.16em;color:#9cbbb1;margin-top:3px}.side-tag{display:inline-block;background:#314b4e;color:#b2e4ca;margin:26px 21px 12px;padding:8px 10px;font:10px 'DejaVu Sans Mono';letter-spacing:.08em;border-radius:4px}.navgroup{padding:13px 12px 4px}.nav-caption{font:9px 'DejaVu Sans Mono';letter-spacing:.21em;color:#809a9f;text-transform:uppercase;padding:0 12px;margin:13px 0 9px}.navitem{display:flex;align-items:center;gap:11px;padding:11px 13px;border-radius:6px;color:#bbcdcb;font-size:12px;font-weight:600;margin:3px 0}.navitem.active{background:#d9ede2;color:#19312e}.navitem .ico{width:20px;text-align:center;font-size:17px;opacity:.95}.navitem .flag{margin-left:auto;font:9px 'DejaVu Sans Mono';color:#9aafa8}.navitem.active .flag{color:#2e635c}.navitem:hover:not(.active){background:#263b43}.sidebar-footer{margin-top:auto;border-top:1px solid #33454a;padding:21px}.sidebar-footer p{font-size:10px;line-height:1.6;color:#a4b8b4}.sidebar-footer .account{display:flex;align-items:center;gap:11px;margin-top:20px}.avatar{background:#e0bc8c;color:#352e2a;width:34px;height:34px;display:grid;place-items:center;border-radius:50%;font-size:12px;font-weight:800}.admin-main{flex:1;min-width:0}.admin-top{height:68px;background:#fff;border-bottom:1px solid #dce3df;padding:0 38px;display:flex;align-items:center;justify-content:space-between}.admin-top .path{font:10px 'DejaVu Sans Mono';letter-spacing:.08em;color:#78878a}.admin-top .path strong{color:#24343a}.top-right{display:flex;gap:15px;align-items:center}.top-right .search{height:35px;min-width:255px;border:1px solid #dbe2df;padding:0 12px;border-radius:6px;font-size:11px;color:#91a0a0;display:flex;align-items:center;gap:9px}.admin-body{padding:29px 38px 42px}.admin-intro{display:flex;align-items:end;justify-content:space-between;gap:18px}.admin-intro h1{margin:9px 0 6px;font:700 38px 'DejaVu Sans';letter-spacing:-.065em}.admin-intro p{color:#67767b;font-size:13px;margin:0}.admin-actions{display:flex;gap:10px}.admin-actions .btn{padding:12px 15px}.demo-banner{margin-top:24px;border:1px solid #e1d0aa;background:#fbf4e3;border-radius:8px;display:flex;align-items:center;justify-content:space-between;padding:11px 15px;color:#775b2a;font-size:11px;gap:10px}.demo-banner strong{font:700 10px 'DejaVu Sans Mono';letter-spacing:.07em}.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-top:22px}.summary{background:#fff;border:1px solid #dde5e0;border-radius:9px;min-height:118px;padding:18px}.summary .top{display:flex;justify-content:space-between;align-items:center;font:10px 'DejaVu Sans Mono';letter-spacing:.07em;color:#64757b}.summary .big{font:700 23px 'DejaVu Sans';letter-spacing:-.045em;margin-top:22px}.summary .more{font-size:10px;color:#87938f;margin-top:6px}.summary .tinyicon{border:1px solid #dde5e0;background:#f4f7f4;padding:5px 7px;border-radius:5px;font-size:13px;color:#3f7569}.rowpanels{display:grid;grid-template-columns:1.5fr 1fr;gap:15px;margin-top:17px}.panel{background:#fff;border:1px solid #dce3df;border-radius:10px;padding:20px 21px}.panel-head{display:flex;align-items:start;justify-content:space-between;gap:12px;margin-bottom:18px}.panel h2{font:700 19px 'DejaVu Sans';letter-spacing:-.04em;margin:3px 0 5px}.panel p{font-size:11px;color:#7b878d;line-height:1.55;margin:0}.panel-link{font:10px 'DejaVu Sans Mono';letter-spacing:.03em;color:#277568;white-space:nowrap}.pipe{display:flex;align-items:center;justify-content:space-between;gap:5px;margin:22px 0 15px}.pipe-node{width:23%;padding:12px 10px;border:1px solid #e0e6e1;background:#f8faf7;border-radius:6px}.pipe-node b{display:block;font:700 12px 'DejaVu Sans';margin:7px 0 3px}.pipe-node small{font:9px 'DejaVu Sans Mono';color:#789087}.pipe-node .num{font:10px 'DejaVu Sans Mono';color:#6c817e}.pipe-node.good{background:#eaf5ee;border-color:#bee3cf}.pipe-node.blocked{background:#fbf3e7;border-color:#ebdcbd}.pipe-arrow{color:#8aa19b;font-size:20px}.alertline{background:#f8f5ed;border:1px solid #efe6cf;border-radius:5px;padding:10px 12px;font-size:10px;color:#846a44;display:flex;align-items:center;gap:8px}.five{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-top:20px}.five-node{text-align:center;border:1px solid #e3e8e3;border-radius:6px;background:#f6f8f7;padding:13px 2px 12px}.five-node:first-child{background:#def0e5;border-color:#c1dccd}.five-node .ch{display:block;font:700 23px 'DejaVu Sans';letter-spacing:-.07em}.five-node small{font:9px 'DejaVu Sans Mono';color:#687d79}.five-node span{display:block;font:8px 'DejaVu Sans Mono';margin-top:9px;color:#83908d}.panel .statusline{margin-top:20px;padding-top:14px;border-top:1px solid #edf0ed;font-size:10px;color:#68777b}.records-grid{display:grid;grid-template-columns:1.52fr 1fr;gap:15px;margin-top:15px}.table-head{display:grid;grid-template-columns:2fr 1.3fr 1fr;gap:5px;background:#f4f6f3;padding:11px 12px;color:#74847e;font:9px 'DejaVu Sans Mono';text-transform:uppercase}.tr{display:grid;grid-template-columns:2fr 1.3fr 1fr;gap:5px;align-items:center;padding:15px 12px;border-bottom:1px solid #edf0ed;font-size:11px}.tr b{font-size:11px}.tr small{display:block;color:#8b9898;margin-top:5px;font-size:9px}.state{font:9px 'DejaVu Sans Mono';border:1px solid #d4ded9;padding:6px 7px;background:#f8faf8;border-radius:5px;width:max-content}.state.green{background:#eaf4ed;color:#45705e;border-color:#cadecf}.state.amber{background:#fbf3e7;color:#906d3d;border-color:#eadbc6}.reviewbox{margin:12px 0 0;border:1px dashed #cbd9d3;border-radius:7px;background:#f8faf7;padding:24px 19px;display:flex;align-items:start;gap:15px}.reviewbox .circle{background:#e7ede9;color:#56796c;border-radius:50%;width:38px;height:38px;display:grid;place-items:center;font-size:20px;flex-shrink:0}.reviewbox h3{font:700 15px 'DejaVu Sans';margin:1px 0 8px}.reviewbox p{font-size:11px;line-height:1.7}.auditlines{border-top:1px solid #e9eee9;margin-top:18px;padding-top:15px;display:grid;grid-template-columns:1fr 1fr;gap:12px}.auditlines b{font-size:11px}.auditlines p{margin-top:5px}.bottomline{margin-top:16px;color:#83928d;display:flex;justify-content:space-between;font:9px 'DejaVu Sans Mono'}.sidebar button,.navitem{border:0;font-family:inherit;text-align:left}.navitem{cursor:pointer;background:transparent;width:100%}.navitem:focus-visible{outline:2px solid #bdecca}
@media(max-width:1100px){.hero h1{font-size:63px}.home-header,.announcement{padding-left:28px;padding-right:28px}.hero,.product-section,.journey,.fineprint{padding-left:28px;padding-right:28px}.menu{gap:15px}.features{grid-template-columns:repeat(3,1fr)}.sidebar{width:222px}.admin-body{padding:25px}.admin-top{padding:0 25px}}@media(max-width:760px){.announcement{padding:0 18px}.announcement span:last-child{display:none}.home-header{padding:0 18px}.menu{display:none}.hero{padding:45px 18px;grid-template-columns:1fr}.hero h1{font-size:58px}.hero-visual{min-height:390px}.hero-bottom{margin-top:30px}.product-section,.journey,.fineprint{padding:30px 18px}.features{grid-template-columns:repeat(2,1fr)}.journey{grid-template-columns:1fr}.step-chain{flex-wrap:wrap}.sidebar{display:none}.summary-grid{grid-template-columns:repeat(2,1fr)}.rowpanels,.records-grid{grid-template-columns:1fr}.admin-body{padding:18px}.admin-intro h1{font-size:30px}.admin-top{padding:0 18px}.admin-top .search{display:none}}
</style></head><body>
<div class="home-shell"><div class="topstripe"></div><div class="announcement"><span><span class="star">✦</span> MOONWITNESS / OPEN TEXT KNOWLEDGE OBSERVATORY</span><span>READ THE SOURCE · TRACE THE RELATION · KEEP THE DIFFERENCE</span></div>
<header class="home-header"><a href="#top" class="logo"><i class="logo-mark"></i><span>moonwitness<small class="label">ROCKSOUL RESEARCH / CORPUS</small></span></a><nav class="menu"><a href="#modules">Explore</a><a href="#modules">Ontology</a><a href="#modules">Corpus</a><a href="#journey">Reader</a><a href="#journey">Researcher</a></nav><div class="header-actions"><a class="pill" href="https://github.com/bjo163/moonwitness-corpus/tree/dev" target="_blank" rel="noreferrer"><span class="dot ok"></span> DEV SOURCE ↗</a><a href="mockup-admin.html" class="btn">Research Console ↗</a></div></header>
<section class="hero" id="top"><div class="hero-left"><div class="eyebrow"><span class="dash"></span> THE NEXT CHAPTER OF MOONWITNESS</div><h1>Every text<br>has a <em>trail.</em><br>Follow it.</h1><p class="hero-intro">Discover exact sources, connect concepts, read across traditions, and research claims without losing the evidence, context or provenance behind them.</p><form class="searchbar" onsubmit="event.preventDefault(); alert('Mockup only. Production search should connect to the existing /explorer route.')" aria-label="Illustrative search"><span class="search-icon">⌕</span><input aria-label="Search" placeholder="Search a passage, concept, source, tradition…"/><button>Explore ↗</button></form><div class="hints"><span>Try exploring</span><span class="hint">QS 2:82</span><span class="hint">Mark 13:2</span><span class="hint">Textual parallels</span></div><div class="hero-bottom"><div class="stat-small"><strong>01—05</strong><span>Connected product workspaces</span></div><div style="width:1px;height:36px;background:#dbe1de"></div><div class="stat-small"><strong>∞</strong><span>Questions. Evidence before conclusions.</span></div></div></div>
<div class="hero-visual"><div class="orbit-card"><div class="orbit-title">KNOWLEDGE RELATION MAP / SCHEMATIC VIEW</div>
<svg class="orbital" viewBox="0 0 520 470" role="img" aria-label="Conceptual knowledge graph connecting work, edition, passage, evidence and concept"><defs><pattern id="dots" width="23" height="23" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".6" fill="#6c8984"/></pattern></defs><rect width="520" height="470" fill="url(#dots)" opacity=".4"/><g stroke="#789f99" stroke-width="1.2" fill="none" opacity=".48"><path d="M270 230 L100 160 M270 230 L412 143 M270 230 L420 300 M270 230 L148 359 M100 160 L180 70 M412 143 L445 56 M420 300 L437 397 M148 359 L70 425 M100 160 Q270 35 412 143 M148 359 Q260 437 420 300"/><ellipse cx="268" cy="230" rx="184" ry="125" stroke-dasharray="5 8" opacity=".5" transform="rotate(-24 268 230)"/></g><g><circle cx="270" cy="230" r="69" fill="#31595a" stroke="#bce7c4" stroke-width="2"/><circle cx="270" cy="230" r="59" fill="#284649" stroke="#81b5a6" stroke-dasharray="3 6"/><text x="270" y="222" text-anchor="middle" font-size="22" font-family="Space Grotesk" fill="#eaf7ef" font-weight="700">PASSAGE</text><text x="270" y="246" text-anchor="middle" font-size="10" font-family="IBM Plex Mono" fill="#adc9be" letter-spacing="2">CANONICAL ID</text></g><g font-family="Space Grotesk" font-size="13" font-weight="700" text-anchor="middle"><circle cx="100" cy="160" r="43" fill="#f1db9c"/><text x="100" y="165" fill="#21342e">SOURCE</text><circle cx="412" cy="143" r="48" fill="#c5e8d0"/><text x="412" y="148" fill="#1c3e38">EDITION</text><circle cx="420" cy="300" r="46" fill="#e2d9ef"/><text x="420" y="305" fill="#453956">CONCEPT</text><circle cx="148" cy="359" r="48" fill="#e8a58f"/><text x="148" y="364" fill="#46352c">EVIDENCE</text></g><g fill="#b9d3ce"><circle cx="180" cy="70" r="6"/><circle cx="445" cy="56" r="6"/><circle cx="437" cy="397" r="6"/><circle cx="70" cy="425" r="6"/></g></svg>
<div class="orbit-foot"><span>LINKS REQUIRE SOURCES</span><span>GRAPH PREVIEW / NOT LIVE DATA ●</span></div></div><div class="floating top"><span class="smallcaps muted">Ontology view</span><div class="value">See how<br>ideas connect ↗</div></div><div class="floating bottom"><span class="smallcaps orange">PROVENANCE FIRST</span><div class="value">From quotation<br>back to the source.</div></div></div></section>
<section class="product-section" id="modules"><div class="section-head"><div><div class="section-label">ONE UNIVERSE · FIVE WAYS TO LEARN</div><h2>Choose how you explore.</h2></div><p>One canonical corpus underneath. Distinct tools above it — no silent mixing of original text, assertions, and interpretations.</p></div><div class="features"><a class="feature" href="#journey"><span class="symbol">01</span><span class="arrow">↗</span><h3>Corpus</h3><p>Browse traditions, works, editions and exact passages.</p></a><a class="feature" href="#journey"><span class="symbol">02</span><span class="arrow">↗</span><h3>Ontology</h3><p>Study concepts, identities and qualified relationships.</p></a><a class="feature" href="#journey"><span class="symbol">03</span><span class="arrow">↗</span><h3>Explorer</h3><p>Traverse sources, evidence and contextual connections.</p></a><a class="feature" href="#journey"><span class="symbol">04</span><span class="arrow">↗</span><h3>Reader</h3><p>Read with edition, translation, context and rights visible.</p></a><a class="feature" href="#journey"><span class="symbol">05</span><span class="arrow">↗</span><h3>Researcher</h3><p>Inspect assertions, key witnesses and S1–L5 research.</p></a></div></section>
<section class="journey" id="journey"><div><div class="section-label">DESIGNED AROUND TRACEABLE READING</div><h2>Start with a question.<br>End with a citation.</h2><p>First establish the source. Then separate text, relationships and framed interpretations. Missing evidence stays unknown.</p></div><div class="step-chain"><div class="chain-step"><b>⌕ Search</b>Discover</div><div class="chain-arrow">→</div><div class="chain-step"><b>☷ Source</b>Verify</div><div class="chain-arrow">→</div><div class="chain-step"><b>◎ Trace</b>Connect</div><div class="chain-arrow">→</div><div class="chain-step"><b>↗ Cite</b>Reference</div></div></section><footer class="fineprint"><span>MOONWITNESS · DESIGN CONCEPT · 25 OCT 2026</span><span>NO GLOBAL VERDICTS · NO UNSOURCED CLAIMS · UNKNOWN IS A VALID RESULT</span></footer></div>
</body></html>