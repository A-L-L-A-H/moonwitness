{
  "name": "cab",
  "version": "1.0.0",
  "description": "Change Advisory Board (RFC Governance) and Helpdesk SLA Ticketing",
  "category": "operations",
  "depends": ["__base", "project"],
  "autoInstall": true,
  "defaultEnabled": true,
  "capabilities": ["cab.rfc", "helpdesk.sla"],
  "provides": {
    "routes": ["/api/v1/cab/summary"],
    "models": ["cab.change", "cab.decision", "helpdesk.ticket"],
    "auditActions": ["cab.decision.record", "helpdesk.ticket.resolve"]
  }
}
