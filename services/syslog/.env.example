HOST=127.0.0.1
HTTP_PORT=8092
SYSLOG_UDP_PORT=5140
SYSLOG_TCP_PORT=5514
# UDP 514/TCP 514 need elevated privileges on many systems; defaults use unprivileged ports.
DATABASE_URL=sqlite:./syslog.db?mode=rwc
# Max syslog messages kept in DB (pruned asynchronously in bounded batches). 0 = unlimited.
SYSLOG_MAX_MESSAGES=100000
# TCP framing, connection bounds, and idle/per-frame read timeout (trusted plaintext network).
SYSLOG_MAX_TCP_FRAME_BYTES=65536
SYSLOG_MAX_TCP_CONNECTIONS=256
SYSLOG_MAX_TCP_CONNECTIONS_PER_IP=32
SYSLOG_TCP_READ_TIMEOUT_SECS=30
# Background retention batch pruning controls.
SYSLOG_RETENTION_THRESHOLD=500
SYSLOG_RETENTION_INTERVAL_SECS=10
SYSLOG_RETENTION_BATCH_SIZE=1000
