APP_HOST=127.0.0.1
WEB_PORT=3005
API_PORT=8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ENABLE_EMBEDDINGS=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DATA_DIR=/data
MAX_UPLOAD_GB=500
AI_CHUNK_CHARS=14000
S3_ENDPOINT_URL=http://rclone-s3:9000
S3_BUCKET=mw-memory
S3_REGION=us-east-1
S3_ACCESS_KEY=local-memory-access
S3_SECRET_KEY=replace-this-long-random-secret
MOONWITNESS_SYNC_URL=
MOONWITNESS_SYNC_TOKEN=
MOONWITNESS_BATCH_SIZE=50
MID_ISSUER_URL=https://id.moonwitness.biz.id
MID_JWKS_CACHE_TTL_SECONDS=300
MID_AUDIENCE=moonwitness-memory
# MID_ALLOWED_AUDIENCES=
MEMORY_REQUIRE_AUTH=false
