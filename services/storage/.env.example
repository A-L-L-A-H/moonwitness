HOST=127.0.0.1
HTTP_PORT=8091
STORAGE_ROOT=./data
DATABASE_URL=sqlite:./storage.db?mode=rwc

# S3 protocol credentials.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ALLOW_ANONYMOUS=false
STORAGE_MAX_OBJECT_SIZE=536870912

# Storage backend: filesystem (default) or google_drive.
STORAGE_BACKEND=filesystem
# Required only when STORAGE_BACKEND=google_drive.
# Use a dedicated Google account/folder and an OAuth refresh token with Drive API access.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
