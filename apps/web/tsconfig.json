{
  "extends": "@moonwitness/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["./src/@core/*"],
      "@configs/*": ["./src/configs/*"],
      "@hocs/*": ["./src/hocs/*"],
      "@views/*": ["./src/views/*"],
      "@components/*": ["./src/components/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".cloudflare"]
}
