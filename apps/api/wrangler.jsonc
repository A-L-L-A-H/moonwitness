{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "moonwitness-api",
  "account_id": "5e743e388c349ee7a340be8ba91665fa",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.moonwitness.biz.id/*",
      "zone_name": "moonwitness.biz.id",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rocksoul-auth-db",
      "database_id": "6fc89089-5dda-420e-bae1-019d8c6b2d65",
    },
  ],
  "vars": {
    "NODE_ENV": "production",
    "API_PREFIX": "/api/v1",
    "DATABASE_URL": "d1:rocksoul-auth-db",
    "CORS_ORIGINS": "https://moonwitness.biz.id,https://a-l-l-a-h.com,https://community.moonwitness.biz.id",
    "TRUSTED_PROXY_COUNT": "1",
    "SEED": "0",
    "ALLOW_DEMO_SEED": "0",
    "SESSION_MAX_AGE_DAYS": "7",
    "ARSY_URL": "https://arsy-edge.moonwitness.biz.id",
    "MEMORY_API_URL": "https://memory-edge.moonwitness.biz.id",
    "RADIUS_URL": "https://radius-edge.moonwitness.biz.id",
    "STORAGE_URL": "https://storage-edge.moonwitness.biz.id",
    "SYSLOG_URL": "https://syslog-edge.moonwitness.biz.id",
    "SNMP_POLLER_URL": "https://snmp-edge.moonwitness.biz.id",
    "MID_ISSUER_URL": "https://id.moonwitness.biz.id",
    "MID_ALLOWED_AUDIENCES": "moonwitness-web,moonwitness-cli,rocksoul-dx,allah-sanctuary,moonwitness-api",
  },
}
