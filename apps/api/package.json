{
  "name": "@moonwitness/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "verify:pact": "tsx scripts/verify-pacts.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .turbo dist node_modules"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@libsql/client": "^0.18.0",
    "@moonwitness/addon-base": "workspace:*",
    "@moonwitness/addon-timeline": "workspace:*",
    "@moonwitness/core": "workspace:*",
    "@moonwitness/errors": "workspace:*",
    "@moonwitness/orm": "workspace:*",
    "@moonwitness/schema": "workspace:*",
    "@moonwitness/types": "workspace:*",
    "bcrypt": "^6.0.0",
    "fastify": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@moonwitness/eslint-config": "workspace:*",
    "@moonwitness/typescript-config": "workspace:*",
    "@pact-foundation/pact": "17.1.4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-import": "^2.32.0",
    "tsup": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
