    "@fastify/swagger-ui": "^6.0.0",
    "@libsql/client": "^0.18.0",
    "@moonwitness/addon-ai": "workspace:*",
    "@moonwitness/addon-audit": "workspace:*",
    "@moonwitness/addon-auth": "workspace:*",
    "@moonwitness/addon-base": "workspace:*",
    "@moonwitness/addon-canon-lore": "workspace:*",
    "@moonwitness/addon-command-center": "workspace:*",
    "@moonwitness/addon-control": "workspace:*",
    "@moonwitness/addon-epistemic": "workspace:*",
    "@moonwitness/addon-i18n": "workspace:*",
    "@moonwitness/addon-probes": "workspace:*",
    "@moonwitness/addon-radius": "workspace:*",
    "@moonwitness/addon-snmp": "workspace:*",
    "@moonwitness/addon-storage": "workspace:*",
    "@moonwitness/addon-syslog": "workspace:*",
    "@moonwitness/addon-timeline": "workspace:*",
    "@moonwitness/addon-witness-research": "workspace:*",
    "@moonwitness/ai": "workspace:*",
    "@moonwitness/contracts": "workspace:*",
    "@moonwitness/core": "workspace:*",
    "@moonwitness/errors": "workspace:*",
    "@moonwitness/mid": "workspace:*",
    "@moonwitness/orm": "workspace:*",
    "@moonwitness/schema": "workspace:*",
    "@moonwitness/types": "workspace:*",
    "bcrypt": "^6.0.0",
    "fastify": "^5.1.0",
    "pg": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@moonwitness/eslint-config": "workspace:*",
    "@moonwitness/typescript-config": "workspace:*",
    "@pact-foundation/pact": "16.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "eslint": "^10.14.0",
    "eslint-plugin-import": "^2.32.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
