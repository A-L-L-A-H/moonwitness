# Copy to apps/api/.env and set the bootstrap values before first boot.
# Never commit populated .env files or deploy with sample credentials.
NODE_ENV=development
DATABASE_URL=./moonwitness.db
SEED=0
ALLOW_DEMO_SEED=0
CONTROL_NATIVE_SETUP=1
INSTANCE_NAME=Moonwitness
SESSION_MAX_AGE_DAYS=7
# Number of reverse proxies in front of this API. 0 trusts the socket peer;
# set it to the real proxy depth so rate limiting keys on the caller, not the proxy.
TRUSTED_PROXY_COUNT=0
MW_BOOTSTRAP_ADMIN_USERNAME=
MW_BOOTSTRAP_ADMIN_EMAIL=
MW_BOOTSTRAP_ADMIN_PASSWORD=
MW_BOOTSTRAP_ADMIN_DISPLAY_NAME=
# Server-only S3-compatible Storage credentials; use the same values in services/storage.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Optional local RIOT Intelligence runtime. Only configure an operator-approved
# OpenAI-compatible endpoint; production permits HTTP only for loopback hosts.
RIOT_AI_BASE_URL=http://127.0.0.1:11434
RIOT_AI_MODEL=
RIOT_AI_TIMEOUT_MS=30000
RIOT_AI_MAX_REQUEST_BYTES=65536
RIOT_AI_RATE_LIMIT_MAX=20
RIOT_AI_RATE_LIMIT_WINDOW_MS=60000
RIOT_AI_USAGE_RETENTION_DAYS=90
# Optional apps/memory FastAPI bridge (runs separately without shared DB coupling).
# MEMORY_API_URL=http://127.0.0.1:8000
MEMORY_API_TIMEOUT_MS=10000
# MoonWitness ID JWT verifier settings.
# MID_ISSUER_URL=https://id.moonwitness.biz.id
# MID_ALLOWED_AUDIENCES=moonwitness-web,moonwitness-cli,rocksoul-dx,allah-sanctuary,moonwitness-api
