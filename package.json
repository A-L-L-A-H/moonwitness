{
  "name": "moonwitness",
  "version": "0.21.0",
  "private": true,
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "bun run --filter \"./apps/*\" dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "api:dev": "bun run --filter @moonwitness/api dev",
    "api:build": "bun run --filter @moonwitness/api build",
    "api:start": "bun run --filter @moonwitness/api start",
    "api:test": "bun run --filter @moonwitness/api test",
    "test:conformance:pg": "node scripts/run-pg-conformance.mjs",
    "web:dev": "bun run --filter @moonwitness/web dev",
    "web:build": "bun run --filter @moonwitness/web build",
    "web:start": "bun run --filter @moonwitness/web start",
    "rocksoul": "node scripts/rocksoul-launch.mjs",
    "ui:test": "bun run --filter @moonwitness/ui test",
    "ui:contrast": "bun run --filter @moonwitness/ui ui:contrast",
    "docs:check": "node scripts/doc-check.mjs",
    "docs:test": "node --test scripts/doc-check.test.mjs",
    "gate:quick": "node scripts/gatecheck.mjs quick",
    "gate:local": "node scripts/gatecheck.mjs local",
    "gate:push": "node scripts/gatecheck.mjs push",
    "gate:release": "node scripts/gatecheck.mjs release",
    "gate:doctor": "node scripts/gatecheck.mjs doctor",
    "branch:guard": "node scripts/branch-guard.mjs",
    "branches:clean": "node scripts/branch-guard.mjs --prune",
    "commitlint": "node scripts/commitlint.mjs",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "^8.5.23",
    "esbuild": "^0.28.1",
    "minimatch": "^11.0.1",
    "underscore": "^1.13.8"
  },
  "trustedDependencies": [
    "@swc/core",
    "@tailwindcss/oxide",
    "bcrypt",
    "esbuild",
    "sharp"
  ]
}
