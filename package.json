{
  "name": "moonwitness",
  "version": "0.14.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter \"./apps/*\" --parallel dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "api:dev": "pnpm --filter @moonwitness/api dev",
    "api:build": "pnpm --filter @moonwitness/api build",
    "api:start": "pnpm --filter @moonwitness/api start",
    "api:test": "pnpm --filter @moonwitness/api test",
    "web:dev": "pnpm --filter @moonwitness/web dev",
    "web:build": "pnpm --filter @moonwitness/web build",
    "web:start": "pnpm --filter @moonwitness/web start",
    "rocksoul": "node scripts/rocksoul-launch.mjs",
    "ui:test": "pnpm --filter @moonwitness/ui test",
    "ui:contrast": "pnpm --filter @moonwitness/ui run ui:contrast",
    "docs:check": "node scripts/doc-check.mjs",
    "docs:test": "node --test scripts/doc-check.test.mjs",
    "gate:quick": "node scripts/gatecheck.mjs quick",
    "gate:local": "node scripts/gatecheck.mjs local",
    "gate:push": "node scripts/gatecheck.mjs push",
    "gate:release": "node scripts/gatecheck.mjs release",
    "gate:doctor": "node scripts/gatecheck.mjs doctor",
    "branch:guard": "node scripts/branch-guard.mjs",
    "branches:clean": "node scripts/branch-guard.mjs --prune",
    "commitlint": "node scripts/commitlint.mjs",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
