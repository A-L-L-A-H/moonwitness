# MoonWitness Production Single-VPS Environment Template
# Copy to .env and replace all sensitive placeholders before running docker compose up -d

# --- Public Ingress & TLS (Caddy) ---
ACME_EMAIL=admin@moonwitness.biz.id
DOMAIN_MOONWITNESS=moonwitness.biz.id
DOMAIN_ALLAH=a-l-l-a-h.com
DOMAIN_API=api.moonwitness.biz.id
DOMAIN_ID=id.moonwitness.biz.id

# --- Core Runtime & Node Environment ---
NODE_ENV=production
CORS_ORIGINS=https://moonwitness.biz.id,https://a-l-l-a-h.com,https://id.moonwitness.biz.id
TRUSTED_PROXY_COUNT=1
SESSION_SECRET=change-this-to-a-64-hex-character-session-secret
STORAGE_ACCESS_KEY=mw-storage-access-key
STORAGE_SECRET_KEY=change-this-to-a-64-hex-character-storage-secret

# --- First-Light Onboarding (/setup) & Control Plane ---
# Leave MW_BOOTSTRAP_ADMIN_* unset to enable Coolify-style /setup web onboarding on first boot.
CONTROL_NATIVE_SETUP=1
INSTANCE_NAME=Moonwitness

# --- Centralized Identity (MID) ---
MID_ISSUER_URL=https://id.moonwitness.biz.id
MID_KEY_ENCRYPTION_SECRET=change-this-to-a-secure-32-byte-secret-for-key-encryption
MID_COOKIE_DOMAIN=.moonwitness.biz.id

# --- Database & Seeds ---
SEED=0
ALLOW_DEMO_SEED=0

# --- Network Services: RADIUS ---
# Bind to 0.0.0.0 for external NAS peers protected by host firewall, or specific VPN IP
RADIUS_BIND_IP=0.0.0.0
RADIUS_SECRET=change-this-to-a-secure-shared-nas-secret

# --- Network Services: SNMP Poller ---
SNMP_POLL_INTERVAL=60
SNMP_TIMEOUT_MS=2000

# --- Network Services: Syslog Ingest ---
# Restricted to localhost or VPN interface by default to prevent exposing plaintext syslog to the public internet
SYSLOG_BIND_IP=127.0.0.1
SYSLOG_MAX_MESSAGES=100000
