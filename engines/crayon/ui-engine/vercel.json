{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "CRAYON_RELEASE_SHA=$VERCEL_GIT_COMMIT_SHA EXPECTED_RELEASE_SHA=$VERCEL_GIT_COMMIT_SHA npm run build:lab && npm run verify:deploy && npm run performance:web",
  "outputDirectory": "dist-lab",
  "ignoreCommand": "test \"$VERCEL_GIT_COMMIT_REF\" != \"main\"",
  "git": {
    "deploymentEnabled": {
      "dev": false
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
