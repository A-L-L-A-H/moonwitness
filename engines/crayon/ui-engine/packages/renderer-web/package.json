{
  "name": "allah-crayon-react",
  "version": "0.9.0-alpha.1",
  "description": "React renderer for CRAYON Representation Intermediate Representation.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./safe": { "types": "./dist/safe.d.ts", "import": "./dist/safe.js" },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist"],
  "sideEffects": ["./dist/styles.css"],
  "scripts": { "build": "tsup src/index.tsx src/safe.tsx --format esm --dts --clean --sourcemap --external react && cp src/styles.css dist/styles.css" },
  "dependencies": { "allah-crayon-rir": "0.9.0-alpha.1" },
  "peerDependencies": { "react": ">=18.2.0", "react-dom": ">=18.2.0" },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/bjo163/ALLAH-CRAYON-UI-ENGINE.git", "directory": "packages/renderer-web" },
  "keywords": ["crayon", "react", "semantic-ui", "renderer", "generative-ui"],
  "engines": { "node": ">=20" },
  "license": "UNLICENSED"
}
