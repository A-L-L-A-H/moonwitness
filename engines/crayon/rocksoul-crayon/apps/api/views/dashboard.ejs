<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= data.service.name %> - Gateway Dashboard</title>
  <link rel="icon" href="<%= data.assets.brand.favicon %>" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
  <script>if (window.mermaid) mermaid.initialize({ startOnLoad: true, theme: 'dark' });</script>
  <style>
    :root {
      --bg: #09090b;
      --card: #121215;
      --card-border: #222228;
      --card-hover: #181820;
      --text: #f4f4f5;
      --text-muted: #a1a1aa;
      --text-dim: #71717a;
      --emerald: #10b981;
      --emerald-bg: rgba(16, 185, 129, 0.12);
      --indigo: #6366f1;
      --indigo-bg: rgba(99, 102, 241, 0.14);
      --amber: #f59e0b;
      --amber-bg: rgba(245, 158, 11, 0.12);
      --rose: #f43f5e;
      --rose-bg: rgba(244, 63, 94, 0.12);
      --cyan: #06b6d4;
      --cyan-bg: rgba(6, 182, 212, 0.12);
      --border: rgba(255, 255, 255, 0.08);
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      min-height: 100vh;
      line-height: 1.5;
      padding-bottom: 60px;
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 28px 24px;
    }

    /* Header */
    .header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--card-border);
      margin-bottom: 24px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .brand-logo {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: linear-gradient(135deg, #6366f1, #8b5cf6, #ec4899);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 20px;
      color: #fff;
      box-shadow: 0 4px 20px rgba(99, 102, 241, 0.35);
    }
    .brand-title {
      font-size: 19px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .brand-sub {
      font-size: 13px;
      color: var(--text-muted);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.15s ease;
      cursor: pointer;
      border: 1px solid transparent;
    }
    .btn-secondary {
      background: #27272a;
      color: #fff;
      border-color: #3f3f46;
    }
    .btn-secondary:hover {
      background: #3f3f46;
      border-color: #52525b;
    }
    .btn-primary {
      background: #6366f1;
      color: #fff;
      border-color: #4f46e5;
    }
    .btn-primary:hover {
      background: #4f46e5;
    }
    .btn-danger {
      background: #27272a;
      color: var(--rose);
      border-color: rgba(244, 63, 94, 0.3);
    }
    .btn-danger:hover {
      background: var(--rose-bg);
      border-color: var(--rose);
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: var(--emerald-bg);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: var(--emerald);
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .pulse-dot {
      width: 8px;
      height: 8px;
      background: var(--emerald);
      border-radius: 50%;
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    /* KPI Cards */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 14px;
      margin-bottom: 24px;
    }
    .kpi-card {
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 16px 18px;
      transition: all 0.2s ease;
    }
    .kpi-card:hover {
      border-color: #3f3f46;
      transform: translateY(-2px);
    }
    .kpi-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      margin-bottom: 6px;
      display: flex;
      justify-content: space-between;
    }
    .kpi-value {
      font-size: 22px;
      font-weight: 800;
      color: var(--text);
      font-family: var(--font-mono);
      letter-spacing: -0.02em;
    }
    .kpi-sub {
      font-size: 12px;
      color: var(--text-dim);
      margin-top: 4px;
    }
    .progress-bar {
      width: 100%;
      height: 5px;
      background: #27272a;
      border-radius: 999px;
      margin-top: 8px;
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #6366f1, #a855f7);
      border-radius: 999px;
    }

    /* Tab Navigation */
    .tabs-nav {
      display: flex;
      gap: 6px;
      border-bottom: 1px solid var(--card-border);
      margin-bottom: 24px;
      overflow-x: auto;
      padding-bottom: 4px;
    }
    .tab-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 8px;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .tab-btn:hover {
      color: var(--text);
      background: rgba(255, 255, 255, 0.04);
    }
    .tab-btn.active {
      color: #fff;
      background: #27272a;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }
    .tab-count {
      font-size: 11px;
      padding: 1px 6px;
      border-radius: 999px;
      background: #18181b;
      color: var(--text-muted);
      font-family: var(--font-mono);
    }

    .tab-content {
      display: none;
      animation: fadeIn 0.2s ease-out;
    }
    .tab-content.active {
      display: block;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Grids & Cards */
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 16px;
    }
    .box-card {
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 18px;
    }
    .box-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }
    .box-title {
      font-size: 15px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Badges */
    .badge {
      font-size: 11px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 6px;
      font-family: var(--font-mono);
      display: inline-block;
    }
    .badge-green { background: var(--emerald-bg); color: var(--emerald); border: 1px solid rgba(16, 185, 129, 0.25); }
    .badge-blue { background: var(--indigo-bg); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.25); }
    .badge-cyan { background: var(--cyan-bg); color: #22d3ee; border: 1px solid rgba(6, 182, 212, 0.25); }
    .badge-amber { background: var(--amber-bg); color: var(--amber); border: 1px solid rgba(245, 158, 11, 0.25); }
    .badge-rose { background: var(--rose-bg); color: var(--rose); border: 1px solid rgba(244, 63, 94, 0.25); }

    /* Tables */
    .table-box {
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      overflow-x: auto;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      text-align: left;
    }
    th {
      background: #18181d;
      color: var(--text-muted);
      padding: 10px 14px;
      font-weight: 600;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid var(--card-border);
    }
    td {
      padding: 10px 14px;
      border-bottom: 1px solid var(--card-border);
      color: var(--text);
    }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(255, 255, 255, 0.02); }
    .mono { font-family: var(--font-mono); font-size: 12px; }

    /* Inputs & Forms */
    .filter-bar {
      margin-bottom: 14px;
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
    }
    .search-input {
      background: #18181d;
      border: 1px solid var(--card-border);
      color: #fff;
      padding: 8px 12px;
      border-radius: 8px;
      font-size: 13px;
      width: 100%;
      max-width: 300px;
    }
    .search-input:focus {
      outline: none;
      border-color: #6366f1;
    }

    .form-group { margin-bottom: 14px; }
    .label {
      display: block;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 6px;
    }
    .input-field {
      width: 100%;
      background: #18181f;
      border: 1px solid var(--border);
      color: #fff;
      padding: 10px 12px;
      border-radius: 8px;
      font-size: 13px;
      font-family: var(--font-sans);
    }
    .input-field:focus {
      outline: none;
      border-color: var(--indigo);
    }

    /* Modal */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 20px;
    }
    .modal-card {
      background: #141419;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
      width: 100%;
      max-width: 440px;
      box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.7);
    }

    /* Markdown Body Styling */
    .markdown-body {
      font-size: 14px;
      color: #e4e4e7;
    }
    .markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4 {
      color: #ffffff;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-top: 28px;
      margin-bottom: 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 8px;
    }
    .markdown-body h1 { font-size: 26px; }
    .markdown-body h2 { font-size: 20px; }
    .markdown-body h3 { font-size: 16px; }
    .markdown-body p, .markdown-body ul, .markdown-body ol {
      margin-bottom: 16px;
    }
    .markdown-body ul, .markdown-body ol {
      padding-left: 24px;
    }
    .markdown-body li {
      margin-bottom: 6px;
    }
    .markdown-body a {
      color: #818cf8;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .markdown-body a:hover {
      color: #a5b4fc;
    }
    .markdown-body img {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
      margin: 16px 0;
      display: inline-block;
    }
    .markdown-body pre {
      background: #09090d !important;
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 14px;
      overflow-x: auto;
      font-family: var(--font-mono);
      font-size: 12px;
      margin-bottom: 18px;
    }
    .markdown-body code {
      font-family: var(--font-mono);
      background: rgba(255, 255, 255, 0.06);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 12px;
      color: #cbd5e1;
    }
    .markdown-body pre code {
      background: transparent;
      padding: 0;
      color: #e2e8f0;
    }
    .markdown-body blockquote {
      border-left: 4px solid #6366f1;
      padding-left: 16px;
      margin: 18px 0;
      color: #a1a1aa;
      font-style: italic;
    }
    .markdown-body table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
      font-size: 13px;
    }
    .markdown-body th, .markdown-body td {
      border: 1px solid var(--card-border);
      padding: 10px 14px;
    }
    .markdown-body th {
      background: #181820;
      color: #fff;
    }
    .markdown-body td {
      background: #111116;
    }

    .footer {
      margin-top: 48px;
      text-align: center;
      font-size: 12px;
      color: var(--text-dim);
      border-top: 1px solid var(--card-border);
      padding-top: 24px;
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header class="header">
      <div class="brand">
        <% if (data.assets && data.assets.brand && data.assets.brand.logoHorizontal) { %>
          <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border); border-radius: 12px; padding: 6px 14px; display: flex; align-items: center;">
            <img src="<%= data.assets.brand.logoHorizontal %>" alt="MoonWitness" style="height: 32px; width: auto; object-fit: contain;" />
          </div>
        <% } else { %>
          <div class="brand-logo">RS</div>
        <% } %>
        <div>
          <div class="brand-title"><%= data.service.name %> <span class="badge badge-blue">CRAYON</span></div>
          <div class="brand-sub"><%= data.service.tagline %> • <span class="mono"><%= data.service.environment %></span></div>
        </div>
      </div>
      <div class="header-actions">
        <div class="status-pill">
          <span class="pulse-dot"></span>
          <%= data.service.status %>
        </div>
        <a href="/api/v1/assets" class="btn btn-secondary" target="_blank">🎨 Assets API</a>
        <a href="/documentation" class="btn btn-primary" target="_blank">Swagger API</a>
        <a href="/health" class="btn btn-secondary" target="_blank">Health</a>
        <a href="/?format=json" class="btn btn-secondary" target="_blank">{ } JSON</a>
        <button class="btn btn-danger" onclick="handleLogout()" title="Lock dashboard and end session">
          🔒 Logout
        </button>
      </div>
    </header>

    <!-- Top KPI Grid -->
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-label">Uptime</div>
        <div class="kpi-value"><%= data.service.uptime.human %></div>
        <div class="kpi-sub"><%= data.service.uptime.seconds %>s active</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Heap Memory <span><%= data.system.memory.heapUsagePercentage %></span></div>
        <div class="kpi-value"><%= data.system.memory.heapUsed %></div>
        <div class="progress-bar">
          <div class="progress-fill" style="width: <%= data.system.memory.heapUsagePercentage %>"></div>
        </div>
        <div class="kpi-sub">Allocated: <%= data.system.memory.heapTotal %></div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Registered Users</div>
        <div class="kpi-value"><%= data.users.length %></div>
        <div class="kpi-sub"><%= data.apiKeys.length %> active API keys</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">SQLite Records <span><%= data.database.pingLatency %></span></div>
        <div class="kpi-value"><%= data.database.totalRecords.toLocaleString() %></div>
        <div class="kpi-sub">Across <%= data.database.totalTables %> tables</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">AI Agents & Endpoints</div>
        <div class="kpi-value"><%= data.aiEngine.agents.length %> / <%= data.routes.length %></div>
        <div class="kpi-sub"><%= data.modules.length %> workspace packages</div>
      </div>
    </div>

    <!-- Tab Bar -->
    <nav class="tabs-nav">
      <button class="tab-btn active" onclick="switchTab('tab-overview', this)">
        📊 Overview
      </button>
      <button class="tab-btn" onclick="switchTab('tab-docs', this)">
        📖 Console Specs
      </button>
      <button class="tab-btn" onclick="switchTab('tab-assets', this)">
        🎨 Visual Assets <span class="tab-count"><%= data.assets.surfaces.length %></span>
      </button>
      <button class="tab-btn" onclick="switchTab('tab-users', this)">
        👥 Users & Auth <span class="tab-count"><%= data.users.length %></span>
      </button>
      <button class="tab-btn" onclick="switchTab('tab-database', this)">
        🗄️ Database <span class="tab-count"><%= data.database.totalTables %></span>
      </button>
      <button class="tab-btn" onclick="switchTab('tab-routes', this)">
        🗺️ Routes <span class="tab-count"><%= data.routes.length %></span>
      </button>
      <button class="tab-btn" onclick="switchTab('tab-logs', this)">
        📜 Logs <span class="tab-count"><%= data.recentLogs.length %></span>
      </button>
      <button class="tab-btn" onclick="switchTab('tab-ai', this)">
        🤖 AI Engine <span class="tab-count"><%= data.aiEngine.agents.length %></span>
      </button>
      <button class="tab-btn" onclick="switchTab('tab-packages', this)">
        📦 Packages <span class="tab-count"><%= data.modules.length %></span>
      </button>
      <button class="tab-btn" onclick="switchTab('tab-plugins', this)">
        🔌 Plugins
      </button>
    </nav>

    <!-- Tab Partials Included Cleanly -->
    <%- include('partials/tab-overview', { data: data }) %>
    <%- include('partials/tab-docs', { data: data }) %>
    <%- include('partials/tab-assets', { data: data }) %>
    <%- include('partials/tab-users', { data: data }) %>
    <%- include('partials/tab-database', { data: data }) %>
    <%- include('partials/tab-routes', { data: data }) %>
    <%- include('partials/tab-logs', { data: data }) %>
    <%- include('partials/tab-ai', { data: data }) %>
    <%- include('partials/tab-packages', { data: data }) %>
    <%- include('partials/tab-plugins', { data: data }) %>

    <!-- Footer -->
    <footer class="footer">
      <p>RockSoul Fastify Architecture &copy; 2026. Telemetry generated dynamically in <%= data.service.telemetryGenerationTime %>.</p>
    </footer>
  </div>

  <script>
    function switchTab(tabId, btn) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
      const target = document.getElementById(tabId);
      if (target) target.classList.add('active');
      if (btn) btn.classList.add('active');

      if (tabId === 'tab-docs' && window.mermaid) {
        setTimeout(() => {
          try {
            mermaid.run({ querySelector: '.language-mermaid' });
          } catch (e) {}
        }, 60);
      }
    }

    function openModal(id) {
      document.getElementById(id).style.display = 'flex';
    }
    function closeModal(id) {
      document.getElementById(id).style.display = 'none';
    }

    async function handleLogout() {
      await fetch('/api/dashboard/logout', { method: 'POST' });
      window.location.reload();
    }

    async function toggleUserStatus(userId) {
      try {
        const res = await fetch('/api/dashboard/users/' + encodeURIComponent(userId) + '/toggle', {
          method: 'PATCH',
        });
        const d = await res.json();
        if (d.success) {
          window.location.reload();
        } else {
          alert(d.message || 'Failed updating user');
        }
      } catch (err) {
        alert('Error updating user');
      }
    }

    async function handleCreateUser(e) {
      e.preventDefault();
      const name = document.getElementById('newUserName').value.trim();
      const email = document.getElementById('newUserEmail').value.trim();
      const password = document.getElementById('newUserPassword').value;
      const role = document.getElementById('newUserRole').value;

      try {
        const res = await fetch('/api/dashboard/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, password, role }),
        });
        const d = await res.json();
        if (d.success) {
          window.location.reload();
        } else {
          alert(d.message || 'Failed creating user');
        }
      } catch (err) {
        alert('Error creating user');
      }
    }

    async function handleCreateApiKey(e) {
      e.preventDefault();
      const name = document.getElementById('newKeyName').value.trim();
      const rawScopes = document.getElementById('newKeyScopes').value.trim();
      const scopes = rawScopes ? rawScopes.split(',').map(s => s.trim()).filter(Boolean) : ['*'];

      try {
        const res = await fetch('/api/dashboard/api-keys', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, scopes }),
        });
        const d = await res.json();
        if (d.success && d.data?.rawKey) {
          document.getElementById('generatedKeyVal').value = d.data.rawKey;
          document.getElementById('generatedKeyBox').style.display = 'block';
        } else {
          alert(d.message || 'Failed generating API key');
        }
      } catch (err) {
        alert('Error generating key');
      }
    }

    async function revokeApiKey(keyId) {
      if (!confirm('Are you sure you want to revoke this API key?')) return;
      try {
        const res = await fetch('/api/dashboard/api-keys/' + encodeURIComponent(keyId), {
          method: 'DELETE',
        });
        const d = await res.json();
        if (d.success) {
          window.location.reload();
        } else {
          alert(d.message || 'Failed revoking API key');
        }
      } catch (err) {
        alert('Error revoking key');
      }
    }

    function filterRoutes() {
      const q = (document.getElementById('routeSearch')?.value || '').toLowerCase();
      document.querySelectorAll('#routesTable tbody tr').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
      });
    }

    function filterTables() {
      const q = (document.getElementById('tableSearch')?.value || '').toLowerCase();
      document.querySelectorAll('#tablesTable tbody tr').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
      });
    }

    function filterPackages() {
      const q = (document.getElementById('pkgSearch')?.value || '').toLowerCase();
      document.querySelectorAll('#pkgTable tbody tr').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
      });
    }
  </script>
</body>
</html>
