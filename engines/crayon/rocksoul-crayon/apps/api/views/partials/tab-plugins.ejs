<div id="tab-plugins" class="tab-content">
  <div class="table-box">
    <table>
      <thead>
        <tr>
          <th>Fastify Decorator / Extension</th>
          <th>Type</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% data.plugins.forEach(function(p) { %>
          <tr>
            <td class="mono" style="font-weight: 700; color: #fff;"><%= p.name %></td>
            <td><span class="badge badge-blue"><%= p.type %></span></td>
            <td>
              <span class="badge <%= p.available ? 'badge-green' : 'badge-amber' %>">
                <%= p.available ? 'ACTIVE / LOADED' : 'STANDBY' %>
              </span>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
