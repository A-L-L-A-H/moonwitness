<div id="tab-packages" class="tab-content">
  <div class="filter-bar">
    <input type="text" class="search-input" id="pkgSearch" placeholder="Search packages..." onkeyup="filterPackages()">
    <span style="font-size: 13px; color: var(--text-muted);"><%= data.modules.length %> monorepo packages discovered on disk</span>
  </div>
  <div class="table-box">
    <table id="pkgTable">
      <thead>
        <tr>
          <th>Package Name</th>
          <th>Version</th>
          <th>Path</th>
          <th>Dependencies</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        <% data.modules.forEach(function(pkg) { %>
          <tr>
            <td class="mono" style="font-weight: 700; color: #c084fc;"><%= pkg.name %></td>
            <td><span class="badge badge-blue"><%= pkg.version %></span></td>
            <td class="mono" style="font-size: 11px; color: var(--text-muted);"><%= pkg.path %></td>
            <td class="mono"><%= pkg.dependencies.length %> deps</td>
            <td style="color: var(--text-muted); font-size: 12px;"><%= pkg.description || '-' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
