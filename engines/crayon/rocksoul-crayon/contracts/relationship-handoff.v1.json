{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rocksoul.relationship-handoff.v1",
  "title": "ROCKSOUL Relationship Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "created_at",
    "origin_domain",
    "origin_repository",
    "origin_issue",
    "source_ref",
    "target_ref",
    "proposed_relation_type",
    "support",
    "counterevidence",
    "alternative_relations",
    "confidence",
    "freshness_state",
    "review_status"
  ],
  "properties": {
    "schema_version": { "const": "rocksoul.relationship-handoff.v1" },
    "handoff_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "origin_domain": { "enum": ["STORY", "EVENT", "TEXT", "PERSON", "LAW", "PERSPECTIVE"] },
    "origin_repository": { "type": "string", "pattern": "^rocksoul-[a-z0-9-]+$" },
    "origin_issue": { "type": "string", "minLength": 1 },
    "source_ref": { "type": "string", "pattern": "^rocksoul://" },
    "target_ref": { "type": "string", "pattern": "^rocksoul://" },
    "proposed_relation_type": { "type": "string", "minLength": 1 },
    "support": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "counterevidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "alternative_relations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "freshness_state": { "enum": ["CURRENT", "STALE", "UNKNOWN"] },
    "review_status": { "enum": ["PENDING_CORRELATION_REVIEW", "HELD", "REJECTED", "ACCEPTED"] }
  },
  "x-rocksoul-invariants": {
    "producer_may_create_canonical_edge": false,
    "similarity_alone_is_sufficient": false,
    "qualified_source_and_target_required": true,
    "counterevidence_and_alternatives_required": true,
    "reviewer_repository": "rocksoul-correlation",
    "review_mode": "EVENT_DRIVEN_REVIEW"
  }
}
