{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rocksoul.research-signal.v1",
  "title": "ROCKSOUL Research Signal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "timestamp",
    "slot",
    "action",
    "domain",
    "repository",
    "headline",
    "why_it_matters",
    "evidence_gain",
    "cross_domain_value",
    "novelty",
    "lifecycle_before",
    "lifecycle_after",
    "related_domains",
    "relationship_handoff",
    "next_gate",
    "evidence"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "slot": { "type": "string", "minLength": 1 },
    "action": {
      "enum": ["ADVANCED", "STAGED", "ROUTED", "HANDOFF", "CONVERGENCE", "DISCOVERED", "BLOCKED", "NO_UPDATE"]
    },
    "domain": { "enum": ["STORY", "EVENT", "TEXT", "PERSON", "LAW", "PERSPECTIVE", "RELATIONSHIP"] },
    "repository": { "type": "string", "pattern": "^rocksoul-[a-z0-9-]+$" },
    "headline": { "type": "string", "minLength": 1 },
    "why_it_matters": { "type": "string" },
    "evidence_gain": { "type": "number", "minimum": 0, "maximum": 25 },
    "cross_domain_value": { "type": "number", "minimum": 0, "maximum": 15 },
    "novelty": { "type": "number", "minimum": 0, "maximum": 20 },
    "lifecycle_before": { "type": ["string", "null"] },
    "lifecycle_after": { "type": ["string", "null"] },
    "related_domains": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["STORY", "EVENT", "TEXT", "PERSON", "LAW", "PERSPECTIVE", "RELATIONSHIP"] }
    },
    "relationship_handoff": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "next_gate": { "type": ["string", "null"] },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
