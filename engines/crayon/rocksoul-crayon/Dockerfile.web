# ==========================================
# Base Image: Setup Node & PNPM
# ==========================================
FROM node:22-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@11.17.0 --activate

# ==========================================
# Builder Stage: Install dependencies & build
# ==========================================
FROM base AS builder
WORKDIR /app

# Copy monorepo configurations & source code
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages ./packages
COPY apps ./apps

# Install dependencies in workspace
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

# Build shared packages needed by web
RUN pnpm --filter "./packages/**" build

# Build arguments for Vite frontend
ARG VITE_API_URL=""
ARG VITE_GTM_ID=""
ARG VITE_BASENAME=""

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_GTM_ID=$VITE_GTM_ID
ENV VITE_BASENAME=$VITE_BASENAME

# Build Vite web application
RUN pnpm --filter shadcn-dashboard-vite build

# ==========================================
# Runner Stage: Pure Node.js Vite Preview (No Nginx)
# ==========================================
FROM base AS runner
WORKDIR /app

# Copy monorepo workspace & built web bundle
COPY --from=builder /app ./

EXPOSE 5173

ENV PORT=5173
ENV HOST=0.0.0.0

# Container healthcheck on Vite preview port 5173
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:5173/ || exit 1

CMD ["pnpm", "--filter", "shadcn-dashboard-vite", "preview", "--host", "0.0.0.0", "--port", "5173"]
