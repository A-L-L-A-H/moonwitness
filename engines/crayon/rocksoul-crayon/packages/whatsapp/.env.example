# Environment Mode
NODE_ENV=production

# HTTP Gateway Network
WA_PORT=3001
WA_HOST=0.0.0.0
CORS_ORIGIN=*
LOG_LEVEL=info

# Admin Dashboard Password (Protected Web View)
WA_DASHBOARD_PASSWORD=210491

# Isolated SQLite Database (Stores API Keys)
WA_DATABASE_URL=file:/app/data/whatsapp.db

# WhatsApp Session Storage Directory (Multi-Device Credentials)
WA_SESSIONS_DIR=/app/data/whatsapp-sessions
