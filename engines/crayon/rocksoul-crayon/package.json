{
  "name": "rocksoul-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter @rocksoul/api dev",
    "build": "pnpm --filter \"./packages/**\" --filter @rocksoul/api build",
    "start": "pnpm --filter @rocksoul/api start",
    "db:generate": "pnpm --filter @rocksoul/orm db:generate",
    "db:push": "pnpm --filter @rocksoul/orm db:push",
    "db:migrate": "pnpm --filter @rocksoul/orm db:migrate",
    "db:seed": "pnpm --filter @rocksoul/orm seed",
    "lint": "pnpm --recursive --parallel lint",
    "test:e2e": "tsx tests/e2e/run-all.ts",
    "audit:ui-boundary": "node scripts/audit-ui-boundary.mjs",
    "validate:stewards": "node scripts/validate-research-steward-topology.mjs",
    "certify:research-issues": "node scripts/certify-research-issues.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2"
  }
}
