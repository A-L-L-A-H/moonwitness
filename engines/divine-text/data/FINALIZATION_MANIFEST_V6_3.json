{
  "version": "6.3.0",
  "local_only": true,
  "runtime": "Node.js + React/Vite UI source",
  "commands": {
    "start_ui": "npm run start:all",
    "download_all": "npm run corpus:download:all",
    "verify_all": "npm run corpus:verify",
